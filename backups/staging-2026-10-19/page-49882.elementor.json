    "settings": {
     "html": "<style>\n.elementor-widget-html > .elementor-widget-container { padding: 0 !important; margin: 0 !important; max-width: none !important; }\n.elementor-element:has(.elementor-widget-html > .elementor-widget-container > .kf-page) { max-width: none !important; width: 100vw !important; margin-left: calc(50% - 50vw) !important; margin-right: calc(50% - 50vw) !important; padding-left: 0 !important; padding-right: 0 !important; }\n.elementor-element:has(.kf-page) > .elementor-widget-wrap, .elementor-element:has(.kf-page) > .elementor-container, .elementor-element:has(.kf-page) > .e-con-inner { max-width: none !important; width: 100% !important; }\n\n.kf-page { --navy: #2f4156; --text: #1a1a1a; --muted: #6b6b6b; --white: #ffffff; --off: #f7f7f5; --border: #e8e8e4; --gold: #f5a623; --sans: -apple-system, BlinkMacSystemFont, \"DM Sans\", \"Segoe UI\", sans-serif; --ease: cubic-bezier(.4,0,.2,1); font-family: var(--sans) !important; font-size: 15px !important; line-height: 1.6 !important; color: var(--text) !important; background: var(--white) !important; -webkit-font-smoothing: antialiased !important; width: 100% !important; display: block !important; position: relative !important; overflow-x: hidden !important; }\n.kf-page *, .kf-page *::before, .kf-page *::after { box-sizing: border-box !important; margin: 0 !important; padding: 0 !important; line-height: inherit !important; }\n.kf-page a { text-decoration: none !important; color: inherit !important; }\n.kf-page img { display: block !important; max-width: 100% !important; }\n.kf-page button { font-family: var(--sans) !important; }\n\n.kf-page .sr { opacity: 0 !important; transform: translateY(24px) !important; transition: opacity 0.6s var(--ease), transform 0.6s var(--ease) !important; }\n.kf-page .sr.sr-left { transform: translateX(-24px) !important; }\n.kf-page .sr.sr-right { transform: translateX(24px) !important; }\n.kf-page .sr.in { opacity: 1 !important; transform: none !important; }\n.kf-page .sr-d1 { transition-delay: 0.08s !important; }\n.kf-page .sr-d2 { transition-delay: 0.16s !important; }\n.kf-page .sr-d3 { transition-delay: 0.24s !important; }\n\n.kf-page .kf-w { max-width: 1160px !important; margin: 0 auto !important; padding: 0 32px !important; }\n.kf-page .kf-eyebrow { font-size: 11px !important; font-weight: 700 !important; letter-spacing: 0.13em !important; text-transform: uppercase !important; color: var(--navy) !important; display: block !important; margin-bottom: 10px !important; }\n\n/* HERO */\n.kf-page .kf-hero { position: relative !important; height: 88vh !important; min-height: 520px !important; max-height: 780px !important; overflow: hidden !important; display: flex !important; align-items: flex-end !important; }\n.kf-page .kf-hero-img { position: absolute !important; inset: 0 !important; background: linear-gradient(to bottom, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.54) 68%, rgba(0,0,0,0.78) 100%), url(\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/02/Ontwerp-zonder-titel-_1__11zon.webp\") center/cover no-repeat !important; transform: scale(1.08) !important; }\n.kf-page .kf-hero-content { position: relative !important; z-index: 2 !important; width: 100% !important; padding: 0 48px 56px !important; max-width: 1160px !important; margin: 0 auto !important; }\n.kf-page .kf-hero-tag { display: inline-block !important; font-size: 11px !important; font-weight: 700 !important; letter-spacing: 0.14em !important; text-transform: uppercase !important; color: rgba(255,255,255,0.5) !important; margin-bottom: 12px !important; }\n.kf-page .kf-hero h1 { font-size: clamp(34px, 5.5vw, 68px) !important; font-weight: 800 !important; color: #fff !important; line-height: 1.03 !important; letter-spacing: -0.04em !important; margin-bottom: 20px !important; max-width: 720px !important; }\n.kf-page .kf-hero h1 em { font-style: italic !important; font-weight: 400 !important; color: rgba(255,255,255,0.75) !important; }\n.kf-page .kf-hero-meta { display: flex !important; align-items: center !important; gap: 10px !important; flex-wrap: wrap !important; }\n.kf-page .kf-hero-pill { display: inline-flex !important; align-items: center !important; padding: 8px 15px !important; border-radius: 999px !important; background: rgba(255,255,255,0.12) !important; border: 1px solid rgba(255,255,255,0.18) !important; color: rgba(255,255,255,0.9) !important; font-size: 13px !important; font-weight: 600 !important; backdrop-filter: blur(6px) !important; }\n.kf-page .kf-hero-cta { display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 13px 26px !important; background: #fff !important; color: var(--navy) !important; border-radius: 10px !important; font-size: 14px !important; font-weight: 700 !important; transition: background 0.2s, transform 0.2s !important; }\n.kf-page .kf-hero-cta:hover { background: #f0f0ee !important; transform: translateY(-1px) !important; }\n\n/* INTRO */\n.kf-page .kf-intro { padding: 76px 0 68px !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-intro-inner { display: grid !important; grid-template-columns: 1fr 380px !important; gap: 72px !important; align-items: start !important; }\n.kf-page .kf-intro-left h2 { font-size: clamp(24px, 3.2vw, 40px) !important; font-weight: 800 !important; line-height: 1.08 !important; letter-spacing: -0.035em !important; margin-bottom: 20px !important; }\n.kf-page .kf-intro-left p { font-size: 15px !important; color: #444 !important; line-height: 1.75 !important; margin-bottom: 16px !important; max-width: 500px !important; }\n.kf-page .kf-joris { background: var(--off) !important; border: 1px solid var(--border) !important; border-radius: 18px !important; overflow: hidden !important; position: sticky !important; top: 100px !important; }\n.kf-page .kf-joris-img { width: 100% !important; aspect-ratio: 4/3 !important; overflow: hidden !important; }\n.kf-page .kf-joris-img img { width: 100% !important; height: 100% !important; object-fit: cover !important; }\n.kf-page .kf-joris-body { padding: 20px 22px 24px !important; }\n.kf-page .kf-joris-quote { font-size: 14px !important; line-height: 1.68 !important; font-style: italic !important; margin-bottom: 16px !important; position: relative !important; padding-left: 14px !important; color: var(--text) !important; }\n.kf-page .kf-joris-quote::before { content: \"\" !important; position: absolute !important; left: 0 !important; top: 4px !important; bottom: 4px !important; width: 3px !important; background: var(--navy) !important; border-radius: 2px !important; }\n.kf-page .kf-joris-name { display: flex !important; align-items: center !important; gap: 10px !important; }\n.kf-page .kf-joris-avatar { width: 36px !important; height: 36px !important; border-radius: 50% !important; background: var(--navy) !important; display: flex !important; align-items: center !important; justify-content: center !important; color: #fff !important; font-size: 14px !important; font-weight: 700 !important; flex-shrink: 0 !important; }\n.kf-page .kf-joris-info strong { display: block !important; font-size: 13px !important; font-weight: 700 !important; }\n.kf-page .kf-joris-info span { font-size: 12px !important; color: var(--muted) !important; }\n.kf-page .kf-joris-wa { display: flex !important; align-items: center !important; gap: 8px !important; margin-top: 16px !important; padding: 11px 15px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 13px !important; font-weight: 700 !important; transition: background 0.2s !important; }\n.kf-page .kf-joris-wa:hover { background: #1dba57 !important; }\n\n/* GELEGENHEDEN */\n.kf-page .kf-gel-sec { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; background: var(--off) !important; }\n.kf-page .kf-gel-sec h2 { font-size: clamp(20px, 2.4vw, 30px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 8px !important; }\n.kf-page .kf-gel-sec > .kf-w > p { font-size: 14px !important; color: var(--muted) !important; margin-bottom: 28px !important; }\n.kf-page .kf-gel-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 10px !important; }\n.kf-page .kf-gel-card { padding: 18px !important; background: #fff !important; border: 1.5px solid var(--border) !important; border-radius: 14px !important; transition: border-color 0.18s, transform 0.18s !important; }\n.kf-page .kf-gel-card:hover { border-color: var(--navy) !important; transform: translateY(-2px) !important; }\n.kf-page .kf-gel-icon { font-size: 20px !important; margin-bottom: 8px !important; display: block !important; }\n.kf-page .kf-gel-card strong { display: block !important; font-size: 13px !important; font-weight: 700 !important; margin-bottom: 3px !important; }\n.kf-page .kf-gel-card span { font-size: 12px !important; color: var(--muted) !important; }\n\n/* REVIEW */\n.kf-page .kf-review { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-review-inner { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 72px !important; align-items: center !important; }\n.kf-page .kf-stars { display: flex !important; gap: 3px !important; margin-bottom: 18px !important; }\n.kf-page .kf-star { color: var(--gold) !important; font-size: 18px !important; }\n.kf-page .kf-review-quote { font-size: clamp(16px, 1.8vw, 21px) !important; font-weight: 500 !important; line-height: 1.5 !important; margin-bottom: 22px !important; }\n.kf-page .kf-review-author { display: flex !important; align-items: center !important; gap: 10px !important; }\n.kf-page .kf-review-avatar { width: 40px !important; height: 40px !important; border-radius: 50% !important; background: var(--navy) !important; display: flex !important; align-items: center !important; justify-content: center !important; color: #fff !important; font-size: 15px !important; font-weight: 700 !important; flex-shrink: 0 !important; }\n.kf-page .kf-review-author strong { display: block !important; font-size: 13px !important; font-weight: 700 !important; }\n.kf-page .kf-review-author span { font-size: 12px !important; color: var(--muted) !important; }\n.kf-page .kf-review-photo { border-radius: 16px !important; overflow: hidden !important; aspect-ratio: 4/3 !important; }\n.kf-page .kf-review-photo img { width: 100% !important; height: 100% !important; object-fit: cover !important; }\n.kf-page .kf-more-reviews { display: inline-flex !important; align-items: center !important; gap: 6px !important; margin-top: 18px !important; font-size: 13px !important; font-weight: 600 !important; color: var(--navy) !important; border-bottom: 1.5px solid var(--navy) !important; padding-bottom: 1px !important; transition: gap 0.2s !important; }\n.kf-page .kf-more-reviews:hover { gap: 10px !important; }\n\n/* REGIO PILLS */\n.kf-page .kf-regio-sec { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-regio-blok { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 56px !important; align-items: start !important; }\n.kf-page .kf-regio-blok-left h2 { font-size: clamp(18px, 2vw, 26px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 8px !important; margin-top: 8px !important; }\n.kf-page .kf-regio-blok-left p { font-size: 13px !important; color: var(--muted) !important; line-height: 1.65 !important; max-width: 340px !important; }\n.kf-page .kf-regio-pills { display: flex !important; flex-wrap: wrap !important; gap: 7px !important; padding-top: 4px !important; }\n.kf-page .kf-regio-pill { display: inline-flex !important; align-items: center !important; gap: 5px !important; padding: 7px 13px !important; border: 1.5px solid var(--border) !important; border-radius: 999px !important; font-size: 13px !important; font-weight: 600 !important; color: var(--navy) !important; background: #fff !important; transition: background 0.18s, border-color 0.18s, transform 0.18s !important; }\n.kf-page .kf-regio-pill:hover { background: #eef2f6 !important; border-color: var(--navy) !important; transform: translateY(-1px) !important; }\n\n/* FAQ */\n.kf-page .kf-faq-sec { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-faq-inner { display: grid !important; grid-template-columns: 260px 1fr !important; gap: 72px !important; align-items: start !important; }\n.kf-page .kf-faq-left h2 { font-size: clamp(20px, 2.2vw, 28px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 10px !important; }\n.kf-page .kf-faq-left p { font-size: 13px !important; color: var(--muted) !important; line-height: 1.65 !important; margin-bottom: 20px !important; }\n.kf-page .kf-faq-wa { display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 11px 18px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 13px !important; font-weight: 700 !important; transition: background 0.2s !important; }\n.kf-page .kf-faq-wa:hover { background: #1dba57 !important; }\n.kf-page .kf-faq-item { border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-faq-q { width: 100% !important; text-align: left !important; padding: 16px 0 !important; font-size: 14px !important; font-weight: 600 !important; color: var(--text) !important; background: none !important; border: none !important; cursor: pointer !important; display: flex !important; justify-content: space-between !important; align-items: center !important; gap: 16px !important; transition: color 0.2s !important; }\n.kf-page .kf-faq-q:hover { color: var(--navy) !important; }\n.kf-page .kf-faq-icon { width: 22px !important; height: 22px !important; border-radius: 50% !important; background: var(--off) !important; border: 1px solid var(--border) !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; font-size: 14px !important; transition: background 0.22s, transform 0.3s var(--ease), border-color 0.22s !important; color: var(--navy) !important; }\n.kf-page .kf-faq-item.open .kf-faq-icon { background: var(--navy) !important; color: #fff !important; border-color: var(--navy) !important; transform: rotate(45deg) !important; }\n.kf-page .kf-faq-a { overflow: hidden !important; max-height: 0 !important; transition: max-height 0.4s var(--ease), padding 0.3s !important; font-size: 13px !important; color: #555 !important; line-height: 1.7 !important; padding: 0 32px 0 0 !important; }\n.kf-page .kf-faq-item.open .kf-faq-a { max-height: 300px !important; padding-bottom: 16px !important; }\n\n/* CTA */\n.kf-page .kf-cta { padding: 68px 0 !important; }\n.kf-page .kf-cta-inner { display: grid !important; grid-template-columns: 1fr auto !important; gap: 36px !important; align-items: center !important; background: var(--navy) !important; border-radius: 20px !important; padding: 48px 56px !important; }\n.kf-page .kf-cta-inner h2 { font-size: clamp(20px, 2.2vw, 30px) !important; font-weight: 800 !important; color: #fff !important; letter-spacing: -0.03em !important; margin-bottom: 6px !important; }\n.kf-page .kf-cta-inner p { font-size: 14px !important; color: rgba(255,255,255,0.6) !important; }\n.kf-page .kf-cta-btns { display: flex !important; flex-direction: column !important; gap: 10px !important; flex-shrink: 0 !important; }\n.kf-page .kf-btn-white { display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 8px !important; padding: 13px 24px !important; background: #fff !important; color: var(--navy) !important; border-radius: 10px !important; font-size: 14px !important; font-weight: 700 !important; white-space: nowrap !important; transition: background 0.2s, transform 0.2s !important; }\n.kf-page .kf-btn-white:hover { background: #f0f0ee !important; transform: translateY(-1px) !important; }\n.kf-page .kf-btn-wa { display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 8px !important; padding: 13px 24px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 14px !important; font-weight: 700 !important; white-space: nowrap !important; transition: background 0.2s, transform 0.2s !important; }\n.kf-page .kf-btn-wa:hover { background: #1dba57 !important; transform: translateY(-1px) !important; }\n\n@media (max-width: 960px) {\n  .kf-page .kf-intro-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-joris { position: static !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: repeat(2, 1fr) !important; }\n  .kf-page .kf-review-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-regio-blok { grid-template-columns: 1fr !important; gap: 20px !important; }\n  .kf-page .kf-faq-inner { grid-template-columns: 1fr !important; gap: 28px !important; }\n  .kf-page .kf-cta-inner { grid-template-columns: 1fr !important; }\n  .kf-page .kf-cta-btns { flex-direction: row !important; }\n}\n@media (max-width: 600px) {\n  .kf-page .kf-w { padding: 0 20px !important; }\n  .kf-page .kf-hero-content { padding: 0 20px 40px !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: 1fr !important; }\n  .kf-page .kf-cta-inner { padding: 32px 22px !important; }\n  .kf-page .kf-cta-btns { flex-direction: column !important; }\n}\n</style>\n\n<div class=\"kf-page\">\n\n<section class=\"kf-hero\">\n  <div class=\"kf-hero-img\" id=\"kf-p-lgem\"></div>\n  <div class=\"kf-hero-content\">\n    <span class=\"kf-hero-tag\">Lasergame huren · Emmen</span>\n    <h1>Lasergame huren<br><em>in Emmen.</em></h1>\n    <div class=\"kf-hero-meta\">\n      <a href=\"/product/lasergame-xl-huren/\" class=\"kf-hero-cta\">Direct boeken →</a>\n      <span class=\"kf-hero-pill\">✓ Bezorgd in Emmen</span><span class=\"kf-hero-pill\">✓ Geen borg</span><span class=\"kf-hero-pill\">✓ Gratis v.a. €150</span>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-intro\">\n  <div class=\"kf-w\">\n    <div class=\"kf-intro-inner\">\n      <div class=\"kf-intro-left\">\n        <span class=\"kf-eyebrow sr\">Lasergame huren in Emmen</span>\n        <h2 class=\"sr sr-d1\">Kant-en-klaar bezorgd in Emmen en omgeving</h2>\n        <p class=\"sr sr-d2\">Lasergame huren in Emmen doe je bij DagpakketVerhuur — dé verhuurspecialist voor Noord-Nederland. Of je nu een spannend kinderfeestje organiseert, een actief bedrijfsuitje plant of gewoon een onvergetelijke middag wil met vrienden: wij bezorgen alles kant-en-klaar aan huis in Emmen en de omliggende plaatsen.</p>\n<p class=\"sr sr-d3\">Geen borg, geen ingewikkeld retourproces en geen montage. Wij leveren de laserguns inclusief spelregels en uitleg, jij hoeft alleen maar te genieten. Na afloop halen wij alles weer op, of je stuurt het terug via het meegeleverde DHL retourlabel. Gratis bezorging in Drenthe vanaf €150 besteding.</p>\n<p class=\"sr sr-d4\">Via DHL bezorgen we lasergame ook door heel Nederland — dus ook vrienden of familie buiten Emmen kunnen genieten van ons aanbod.</p>\n      </div>\n      <div class=\"kf-joris sr sr-right sr-d2\">\n        <div class=\"kf-joris-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2025/03/IMG_1962-1-scaled.jpg\" alt=\"Joris van DagpakketVerhuur\" loading=\"lazy\">\n        </div>\n        <div class=\"kf-joris-body\">\n          <p class=\"kf-joris-quote\">Ik bezorg zelf in Emmen en omgeving. Persoonlijk contact — geen callcenter, gewoon Joris die opneemt.</p>\n          <div class=\"kf-joris-name\">\n            <div class=\"kf-joris-avatar\">J</div>\n            <div class=\"kf-joris-info\"><strong>Joris</strong><span>Oprichter DagpakketVerhuur</span></div>\n          </div>\n          <a href=\"https://wa.me/31852129150\" class=\"kf-joris-wa\">&#x1F4AC; WhatsApp Joris direct</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-gel-sec\">\n  <div class=\"kf-w\">\n    <span class=\"kf-eyebrow sr\">Perfect voor</span>\n    <h2 class=\"sr sr-d1\">Lasergame in Emmen past bij elk feest</h2>\n    <p class=\"sr sr-d2\">Van kinderfeestje tot bedrijfsuitje &#x2014; lasergame is altijd een hit.</p>\n    <div class=\"kf-gel-grid\">\n      \n      <a href=\"/kinderfeestje/\" class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F382;</span>\n        <strong>Kinderfeestje thuis</strong>\n        <span>Urenlang actief entertainment voor kids van 7 tot 15 jaar. Bezorgd aan huis in Emmen. Bekijk ons complete kinderfeestje-aanbod.</span>\n      </a>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F4BC;</span>\n        <strong>Bedrijfsuitje in Emmen</strong>\n        <span>Actieve teambuilding voor collega&#x2019;s. Lasergame zorgt voor eerlijke concurrentie, veel gelach en een onvergetelijke dag.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F3AB;</span>\n        <strong>Verjaardag &amp; feest</strong>\n        <span>Voor tieners, studenten of gewoon een groep volwassenen die eens iets anders wil dan bowlen of een etentje.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F3D8;&#xFE0F;</span>\n        <strong>Buurtfeest</strong>\n        <span>Laat de buurt actief tegen elkaar strijden. Lasergame werkt perfect op straat, in een park of op een grasveld in Emmen.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F3EB;</span>\n        <strong>Sportdag &amp; schoolevenement</strong>\n        <span>Ideaal voor scholen en verenigingen in Emmen en omgeving. We leveren voor grote groepen en denken mee over het programma.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F3C6;</span>\n        <strong>Vrijgezellenfeest</strong>\n        <span>Spannender dan een standaard avondje uit. Strijd om de eer op de laatste dag van de vrijheid.</span>\n      </div>\n      </div>\n  </div>\n</section>\n\n<section class=\"kf-review\">\n  <div class=\"kf-w\">\n    <div class=\"kf-review-inner\">\n      <div class=\"kf-review-text sr sr-left\">\n        <div class=\"kf-stars\">&#x2605;&#x2605;&#x2605;&#x2605;&#x2605;</div>\n        <p class=\"kf-review-quote\">&#x201C;Alles werd op tijd bezorgd in Emmen, werkte perfect en werd daarna keurig opgehaald. Nooit meer anders.&#x201D;</p>\n        <div class=\"kf-review-author\">\n          <div class=\"kf-review-avatar\">K</div>\n          <div><strong>Kevin D.</strong><span>Geverifieerde huurder · Emmen</span></div>\n        </div>\n        <a href=\"https://g.page/r/dagpakketverhuur/review\" class=\"kf-more-reviews\">Bekijk alle 25+ reviews &#x2192;</a>\n      </div>\n      <div class=\"kf-review-photo sr sr-right sr-d1\">\n        <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2025/09/IMG_395C64FA2DE4-1.jpg\" alt=\"Lasergame huren Emmen\" loading=\"lazy\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-regio-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-regio-blok sr\">\n      <div class=\"kf-regio-blok-left\">\n        <span class=\"kf-eyebrow\">Lasergame per regio</span>\n        <h2>Lasergame huren in een andere regio?</h2>\n        <p>Wij bezorgen door heel Noord-Nederland. Of via DHL door heel Nederland.</p>\n      </div>\n      <div>\n        <div class=\"kf-regio-pills\"><a href=\"/lasergame-huren/\" class=\"kf-regio-pill\">🇳🇱 Heel Nederland</a><a href=\"/lasergame-huren-friesland/\" class=\"kf-regio-pill\">📍 Friesland</a><a href=\"/lasergame-huren-drenthe/\" class=\"kf-regio-pill\">📍 Drenthe</a><a href=\"/lasergame-huren-groningen/\" class=\"kf-regio-pill\">📍 Groningen</a><a href=\"/lasergame-huren-leeuwarden/\" class=\"kf-regio-pill\">📍 Leeuwarden</a><a href=\"/lasergame-huren-assen/\" class=\"kf-regio-pill\">📍 Assen</a><a href=\"/lasergame-huren-drachten/\" class=\"kf-regio-pill\">📍 Drachten</a><a href=\"/kinderfeestje-emmen/\" class=\"kf-regio-pill\">🎂 Kinderfeestje Emmen</a></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-faq-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-faq-inner\">\n      <div class=\"kf-faq-left sr sr-left\">\n        <span class=\"kf-eyebrow\">Vragen?</span>\n        <h2>Veelgestelde vragen</h2>\n        <p>Staat jouw vraag er niet bij? App Joris direct.</p>\n        <a href=\"https://wa.me/31852129150\" class=\"kf-faq-wa\">&#x1F4AC; WhatsApp Joris</a>\n      </div>\n      <div class=\"kf-faq-list sr sr-d1\">\n        \n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Bezorgen jullie gratis in Emmen?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">Ja, wij bezorgen gratis in Emmen en omgeving bij een besteding vanaf €150. Woon je net buiten Emmen? Geen probleem — we bezorgen door heel Drenthe, van grote steden tot kleine dorpen. Bij bestellingen onder €150 rekenen we een kleine bezorgvergoeding. Check de transportpagina voor het exacte tarief op basis van jouw postcode.</div>\n</div>\n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Is er een borgsom bij lasergame huren in Emmen?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">Nee, wij vragen geen borg. Je betaalt alleen de huurprijs — geen verborgen kosten, geen verrassingen achteraf. Na gebruik stuur je alles terug via DHL met het meegeleverde retourlabel, of wij halen het op in Emmen en omgeving.</div>\n</div>\n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Vanaf welke leeftijd is lasergame geschikt?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">Lasergame is geschikt vanaf ongeveer 7-8 jaar. De geweren zijn licht, veilig en werken met infraroodstralen — geen pijnlijke kogels of lasers. Jonge kinderen onder de 7 jaar kunnen beter kiezen voor een springkussen of buitenbioscoop. Tieners en volwassenen? Die zijn nóg enthousiaster dan de kinderen.</div>\n</div>\n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Hoeveel spelers kunnen er meedoen en wat heb ik nodig?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">Ons Lasergame XL-pakket bevat 16 laserguns — ideaal voor een grotere groep. Wil je meer spelers? Huur meerdere pakketten of speel in teams. Voor de ruimte reken je op minimaal 5×5 meter speeloppervlak, maar groter is altijd leuker. Een tuin, park of sportveld in Emmen werkt perfect. Binnenshuis kan ook, zorg dan voor wat obstakels.</div>\n</div>\n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Hoe ver van tevoren moet ik reserveren in Emmen?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">We adviseren minimaal 3 tot 5 dagen van tevoren te reserveren, zeker in drukke periodes zoals zomervakantie, schoolvakanties en weekenden. In rustigere periodes is last-minute soms mogelijk — stuur een WhatsApp en Joris kijkt wat er kan. Check altijd eerst de beschikbaarheid in de webshop.</div>\n</div>\n<div class=\"kf-faq-item\">\n  <button class=\"kf-faq-q\">Kan ik lasergame combineren met andere huurartikelen?<span class=\"kf-faq-icon\">+</span></button>\n  <div class=\"kf-faq-a\">Zeker. Veel klanten combineren lasergame met een springkussen, gelblaster of archery tag voor een compleet feestprogramma. Je bestelt alles gewoon tegelijk via de webshop — wij bezorgen het in één keer in Emmen. Twijfel je wat goed past bij jouw groep of leeftijd? App Joris even, hij denkt graag mee.</div>\n</div>\n\n      </div>\n    </div>\n  </div>\n</section>\n</div>\n\n<script>\n(function(){\n  var io=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add(\"in\");io.unobserve(e.target);}});},{threshold:0.1});\n  document.querySelectorAll(\".kf-page .sr\").forEach(function(el){io.observe(el);});\n  var p=document.getElementById(\"kf-p-lgem\");\n  if(p)window.addEventListener(\"scroll\",function(){p.style.transform=\"scale(1.08) translateY(\"+(window.scrollY*.24)+\"px)\";},{passive:true});\n  document.querySelectorAll(\".kf-page .kf-faq-q\").forEach(function(btn){\n    btn.addEventListener(\"click\",function(){\n      var item=this.closest(\".kf-faq-item\"),open=item.classList.contains(\"open\");\n      document.querySelectorAll(\".kf-page .kf-faq-item\").forEach(function(i){i.classList.remove(\"open\");});\n      if(!open)item.classList.add(\"open\");\n    });\n  });\n})();\n</script>",
