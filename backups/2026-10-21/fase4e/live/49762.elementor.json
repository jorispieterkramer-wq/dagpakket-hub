    "settings": {
     "html": "<!--\n  ============================================================\n  DAGPAKKETVERHUUR — LASERGAME HUREN (HUB)  (template A)\n  Gegenereerd door regiopaginas/build.py — niet met de hand\n  aanpassen; wijzig de inhoud in de generator en bouw opnieuw.\n  Elementor: 1 container (volle breedte, geen padding) met\n  daarin alleen deze HTML-widget.\n  Rendert in een SHADOW ROOT (zelfde opzet als de homepage).\n  Uitzondering: de productkaarten staan bewust in de light DOM\n  (slot), zodat dpv-shop de Huren-knop kan afhandelen.\n  ============================================================\n-->\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<div id=\"dpv-rg-host\"></div>\n\n<!-- Echte WooCommerce-productkaarten (dpv-shop), light DOM via slot. -->\n<div id=\"dpv-rg-prods\" slot=\"prods\" data-src=\"/product-category/activiteiten-attracties-huren/attracties-activiteiten-huren/\" data-alts=\"{&quot;47238&quot;: &quot;Lasergame Compact huren&quot;, &quot;47235&quot;: &quot;Lasergame XL huren&quot;}\">\n<div data-prod-card style=\"background:#fff;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;height:100%;box-shadow:0 1px 3px rgba(20,24,31,.07)\">\n<a href=\"/product/lasergame-compacte-huren/\" style=\"position:relative;display:block;text-align:left\"><div style=\"width:100%;aspect-ratio:5/4;position:relative;background:#fff\">\n<img src=\"/wp-content/uploads/2026/02/Gemini_Generated_Image_8tjngj8tjngj8tjn_11zon-300x300.webp\" alt=\"Lasergame Compact huren\" loading=\"lazy\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:2px\"  width=\"300\" height=\"300\" /></div>\n<span data-prod-badge style=\"position:absolute;top:8px;left:8px;background:#dbeafe;color:#1e3a8a;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px\">Populair</span>\n</a><div style=\"padding:10px 12px 12px;display:flex;flex-direction:column;flex:1\">\n<a href=\"/product/lasergame-compacte-huren/\" style=\"text-align:left;font-weight:600;font-size:13.5px;color:#14181f;line-height:1.3\">Lasergame Compact</a><div style=\"margin-top:auto;padding-top:10px\"><div style=\"font-weight:700;font-family:Poppins,inherit;font-size:15px;color:#14181f;white-space:nowrap\">€5 <span style=\"font-weight:400;font-size:10.5px;color:#9aa2ad\">incl. BTW</span></div><div style=\"font-size:10.5px;color:#9aa2ad;margin-top:2px;margin-bottom:12px;white-space:nowrap\">Weekendprijs · zo gratis</div>\n<button type=\"button\" data-add-btn class=\"js-dpvs-add\" data-product=\"47238\" data-qty=\"1\" data-label=\"Huren\" style=\"display:flex;align-items:center;justify-content:center;gap:6px;width:100%;background:#fff;color:#2f4156;border:1.5px solid #2f4156;font-weight:600;font-size:13px;padding:9px 0;border-radius:20px\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Huren</button></div></div></div>\n<div data-prod-card style=\"background:#fff;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;height:100%;box-shadow:0 1px 3px rgba(20,24,31,.07)\">\n<a href=\"/product/lasergame-xl-huren/\" style=\"position:relative;display:block;text-align:left\"><div style=\"width:100%;aspect-ratio:5/4;position:relative;background:#fff\">\n<img src=\"/wp-content/uploads/2026/02/Gemini_Generated_Image_yzv4m1yzv4m1yzv4_11zon-300x300.webp\" alt=\"Lasergame XL huren\" loading=\"lazy\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:2px\"  width=\"300\" height=\"300\" /></div>\n<span data-prod-badge style=\"position:absolute;top:8px;left:8px;background:#fef3c7;color:#92400e;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px\">Bestseller</span>\n</a><div style=\"padding:10px 12px 12px;display:flex;flex-direction:column;flex:1\">\n<a href=\"/product/lasergame-xl-huren/\" style=\"text-align:left;font-weight:600;font-size:13.5px;color:#14181f;line-height:1.3\">Lasergame XL</a><div style=\"margin-top:auto;padding-top:10px\"><div style=\"font-weight:700;font-family:Poppins,inherit;font-size:15px;color:#14181f;white-space:nowrap\">€7 <span style=\"font-weight:400;font-size:10.5px;color:#9aa2ad\">incl. BTW</span></div><div style=\"font-size:10.5px;color:#9aa2ad;margin-top:2px;margin-bottom:12px;white-space:nowrap\">Weekendprijs · zo gratis</div>\n<button type=\"button\" data-add-btn class=\"js-dpvs-add\" data-product=\"47235\" data-qty=\"1\" data-label=\"Huren\" style=\"display:flex;align-items:center;justify-content:center;gap:6px;width:100%;background:#fff;color:#2f4156;border:1.5px solid #2f4156;font-weight:600;font-size:13px;padding:9px 0;border-radius:20px\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Huren</button></div></div></div>\n</div>\n<style>\n/* Volle breedte, zoals de vorige regiopagina's (thema-container opheffen). */\n.elementor-widget-html > .elementor-widget-container:has(> #dpv-rg-host){padding:0 !important;margin:0 !important;max-width:none !important}\n.elementor-element:has(.elementor-widget-html > .elementor-widget-container > #dpv-rg-host){max-width:none !important;width:100vw !important;margin-left:calc(50% - 50vw) !important;margin-right:calc(50% - 50vw) !important}\n.elementor-element:has(#dpv-rg-host) > .elementor-widget-wrap,.elementor-element:has(#dpv-rg-host) > .elementor-container,.elementor-element:has(#dpv-rg-host) > .e-con-inner{max-width:none !important;width:100% !important}\n#dpv-rg-prods{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;align-items:stretch}\n#dpv-rg-prods [data-prod-card]{height:100%}\n/* toast van dpv-shop gebruikt var(--ink); die bestaat buiten de shop niet */\n.dpvs-toast{--ink:#14181f}\n</style>\n\n<template id=\"dpv-rg-tpl\">\n<style>\n:host{display:block}\n*{box-sizing:border-box;margin:0;padding:0;border:0;background:none;font:inherit;color:inherit;\n  letter-spacing:normal;text-transform:none;text-decoration:none;list-style:none}\n.dpv-home{--pri:#2f4156;--ink:#14181f;--mut:#5b6472;--soft:#9aa2ad;--line:#ececec;\n  font-family:Inter,Arial,sans-serif;font-size:16px;font-weight:400;line-height:1.5;\n  color:var(--ink);text-wrap:pretty;background:#fafafa;padding-bottom:96px}\na{color:var(--pri);cursor:pointer}\nh1,h2,h3,.dpv-num{font-family:Poppins,Arial,sans-serif}\nimg{display:block;max-width:100%}\nbutton{cursor:pointer}\n.dpv-wrap{max-width:1280px;margin:0 auto;padding:72px 32px 0}\n.dpv-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n\n/* hero */\n.dpv-hero{position:relative;height:600px;overflow:hidden;background:#14181f}\n.dpv-hero>img.dpv-img{object-position:50% 50%}\n.dpv-hero-scrim{position:absolute;inset:0;pointer-events:none;\n  background:linear-gradient(0deg,rgba(10,12,16,.72) 0%,rgba(10,12,16,.35) 45%,rgba(10,12,16,.1) 70%),\n    linear-gradient(90deg,rgba(10,12,16,.45) 0%,rgba(10,12,16,0) 60%)}\n.dpv-hero-body{position:absolute;left:0;right:0;bottom:0;padding:0 32px 56px}\n.dpv-hero-inner{max-width:1280px;margin:0 auto}\n.dpv-hero-col{max-width:560px}\n.dpv-eyebrow{font-size:13px;font-weight:600;color:#fff;opacity:.85;letter-spacing:.03em;margin-bottom:16px}\n.dpv-hero h1{font-size:42px;line-height:1.16;font-weight:700;margin-bottom:18px;color:#fff;letter-spacing:-.01em}\n.dpv-hero-sub{font-size:15.5px;color:#e7e9ec;line-height:1.7;margin-bottom:28px;max-width:440px}\n.dpv-cta-row{display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n.dpv-btn{background:#fff;color:var(--ink);font-weight:600;font-size:14.5px;\n  padding:15px 26px;border-radius:8px;display:inline-block}\n.dpv-btn:hover{background:#f1f2f4}\n.dpv-btn-dark{background:var(--pri);color:#fff}\n.dpv-btn-dark:hover{background:#24344a}\n.dpv-link-ul{color:#fff;font-weight:600;font-size:14.5px;border-bottom:1.5px solid #fff;padding-bottom:2px}\n.dpv-link-ul:hover{opacity:.85}\n\n/* sectiekoppen */\n.dpv-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;margin-bottom:28px;gap:8px 12px}\n.dpv-head h2{font-size:22px;font-weight:700}\n.dpv-head a{font-weight:600;font-size:13.5px;white-space:nowrap}\n.dpv-lead{font-size:15px;color:var(--mut);line-height:1.7;max-width:640px;margin:-16px 0 28px}\n.dpv-kicker{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#a8935f;margin-bottom:14px}\n\n/* trustbar */\n.dpv-trust{max-width:1280px;margin:0 auto;padding:0 32px}\n.dpv-trust ul{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-radius:12px;\n  box-shadow:0 1px 3px rgba(20,24,31,.07);margin-top:-36px;position:relative}\n.dpv-trust li{display:flex;gap:12px;align-items:flex-start;padding:20px 22px;border-left:1px solid var(--line)}\n.dpv-trust li:first-child{border-left:0}\n.dpv-trust .dpv-ic{flex-shrink:0;color:var(--pri);margin-top:1px}\n.dpv-trust strong{display:block;font-weight:600;font-size:14px;line-height:1.35}\n.dpv-trust small{display:block;font-size:12.5px;color:var(--mut);line-height:1.45;margin-top:2px}\n\n/* intro */\n.dpv-intro{display:grid;grid-template-columns:5fr 7fr;gap:48px;align-items:start}\n.dpv-intro h2{font-size:27px;font-weight:700;line-height:1.3}\n.dpv-intro p{font-size:15px;color:#5c6068;line-height:1.75;margin-bottom:14px}\n.dpv-intro p:last-child{margin-bottom:0}\n\n/* producten: kaarten in light DOM, info-kaart ernaast */\n.dpv-prodrow{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch}\n::slotted(#dpv-rg-prods){display:grid}\n\n/* kaarten (zelfde wit/radius/schaduw als de productkaarten) */\n.dpv-card{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(20,24,31,.07);padding:24px;\n  display:flex;flex-direction:column}\n.dpv-card h3{font-size:16px;font-weight:700;line-height:1.3;margin-bottom:8px}\n.dpv-card p{font-size:14px;color:var(--mut);line-height:1.65}\n.dpv-card .dpv-ic{color:var(--pri);margin-bottom:14px}\n.dpv-card-link{margin-top:auto;padding-top:14px;font-weight:600;font-size:13.5px}\n.dpv-grid{display:grid;gap:16px}\n.dpv-g2{grid-template-columns:repeat(2,1fr)}\n.dpv-g3{grid-template-columns:repeat(3,1fr)}\n.dpv-g4{grid-template-columns:repeat(4,1fr)}\na.dpv-card{color:inherit;transition:box-shadow .2s ease,transform .2s ease}\na.dpv-card:hover{box-shadow:0 6px 18px rgba(20,24,31,.10);transform:translateY(-2px)}\na.dpv-card .dpv-card-link{color:var(--pri)}\n\n.dpv-checks li{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#3d434c;line-height:1.5;padding:7px 0;\n  border-top:1px solid var(--line)}\n.dpv-checks li:first-child{border-top:0}\n.dpv-checks .dpv-ic{color:var(--pri);flex-shrink:0;margin:0}\n\n/* keuzehulp */\n.dpv-pick-tag{display:inline-block;align-self:flex-start;background:#eef1f5;color:var(--pri);font-size:11.5px;font-weight:600;\n  padding:3px 10px;border-radius:20px;margin-bottom:12px}\n.dpv-card-soft{background:#f6f4ef;box-shadow:none}\n\n/* stappen */\n.dpv-step{position:relative}\n.dpv-step-n{font-family:Poppins,Arial,sans-serif;font-weight:700;font-size:13px;color:#fff;background:var(--pri);\n  width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:14px}\n\n/* regio / steden */\n.dpv-place{flex-direction:row;align-items:center;gap:14px;padding:20px 22px}\n.dpv-place .dpv-ic{margin:0;flex-shrink:0}\n.dpv-place strong{display:block;font-family:Poppins,Arial,sans-serif;font-weight:700;font-size:16px}\n.dpv-place small{display:block;font-size:13px;color:var(--mut)}\n.dpv-place .dpv-arr{margin-left:auto;color:var(--pri);font-weight:600}\n.dpv-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.dpv-chips li{background:#fff;border:1px solid #e3e6ea;border-radius:20px;padding:6px 14px;font-size:13.5px;color:#3d434c}\n\n/* ons-verhaal-blok (homepage) — hier voor zakelijk */\n.dpv-about{display:grid;grid-template-columns:1fr 1fr}\n.dpv-about-txt{background:#f6f4ef;padding:48px 48px 48px 0;display:flex;flex-direction:column;\n  justify-content:center;min-height:420px;border-radius:18px 0 0 18px}\n.dpv-about-txt>div{padding-left:32px}\n.dpv-about-txt h2{font-size:27px;font-weight:700;margin-bottom:16px;line-height:1.3}\n.dpv-about-txt p{font-size:15px;color:#5c6068;line-height:1.75;margin-bottom:24px;max-width:460px}\n.dpv-about-txt .dpv-checks{margin-bottom:28px;max-width:460px}\n.dpv-about-txt .dpv-checks li{border-color:#e6e1d6}\n.dpv-link-dark{color:var(--ink);font-weight:600;font-size:14px;border-bottom:1.5px solid var(--ink);padding-bottom:2px;align-self:flex-start}\n.dpv-about-img{position:relative;min-height:420px;border-radius:0 18px 18px 0;overflow:hidden;background:#f6f4ef}\n.dpv-b2b-compact .dpv-about-txt,.dpv-b2b-compact .dpv-about-img{min-height:320px}\n\n/* review (homepage-stijl, één review) */\n.dpv-rev-title{font-size:22px;font-weight:700;margin-bottom:8px;text-align:center}\n.dpv-rev-sub{text-align:center;font-size:14px;color:var(--mut);margin-bottom:28px}\n.dpv-rev{display:grid;grid-template-columns:280px 1fr;gap:32px;align-items:center;max-width:820px;margin:0 auto}\n.dpv-rev-photo{position:relative;aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#f1f2f3}\n.dpv-stars{color:var(--pri);font-size:12px;letter-spacing:.15em;margin-bottom:10px}\n.dpv-rev blockquote p{font-size:19px;color:#3d434c;line-height:1.55;margin-bottom:14px;font-family:Poppins,Arial,sans-serif;font-weight:500}\n.dpv-rev cite{display:block;font-size:11.5px;font-weight:600;letter-spacing:.06em;\n  text-transform:uppercase;color:var(--soft);font-style:normal;line-height:1.5}\n\n/* faq */\n.dpv-faq{display:grid;grid-template-columns:4fr 8fr;gap:48px;align-items:start}\n.dpv-faq-side h2{font-size:22px;font-weight:700;margin-bottom:12px}\n.dpv-faq-side p{font-size:14.5px;color:var(--mut);line-height:1.7;margin-bottom:18px}\n.dpv-contact{display:flex;flex-direction:column;gap:10px}\n.dpv-contact a{display:flex;gap:12px;align-items:center;background:#fff;border-radius:12px;\n  box-shadow:0 1px 3px rgba(20,24,31,.07);padding:14px 16px;color:var(--ink)}\n.dpv-contact a:hover{box-shadow:0 6px 18px rgba(20,24,31,.10)}\n.dpv-contact .dpv-ic{color:var(--pri);flex-shrink:0}\n.dpv-contact strong{display:block;font-weight:600;font-size:14px}\n.dpv-contact small{display:block;font-size:12.5px;color:var(--mut)}\n.dpv-qa{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(20,24,31,.07);margin-bottom:10px}\n.dpv-qa summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center;\n  padding:18px 20px;font-weight:600;font-size:15px;line-height:1.4}\n.dpv-qa summary::-webkit-details-marker{display:none}\n.dpv-qa summary::after{content:'+';font-size:20px;font-weight:400;color:var(--pri);flex-shrink:0;line-height:1}\n.dpv-qa[open] summary::after{content:'–'}\n.dpv-qa .dpv-qa-a{padding:0 20px 18px;font-size:14.5px;color:var(--mut);line-height:1.7}\n.dpv-qa .dpv-qa-a a{font-weight:600}\n\n/* slot-cta (beeldband in hero-stijl) */\n.dpv-final{position:relative;max-width:1216px;margin:72px auto 0;border-radius:18px;overflow:hidden;min-height:380px;\n  display:flex;align-items:flex-end;background:#14181f}\n.dpv-final .dpv-hero-scrim{background:linear-gradient(0deg,rgba(10,12,16,.78) 0%,rgba(10,12,16,.45) 55%,rgba(10,12,16,.2) 100%)}\n.dpv-final-body{position:relative;padding:48px;max-width:640px}\n.dpv-final h2{font-size:30px;line-height:1.2;font-weight:700;color:#fff;margin-bottom:14px}\n.dpv-final p{font-size:15px;color:#e7e9ec;line-height:1.7;margin-bottom:24px}\n.dpv-final-links{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:22px}\n.dpv-final-links a{color:#fff;font-size:13.5px;font-weight:600;opacity:.85;border-bottom:1px solid rgba(255,255,255,.5)}\n.dpv-final-links a:hover{opacity:1}\n\n/* scroll-animatie (homepage) */\n.dpv-anim [data-reveal]{opacity:0;transform:translateY(22px);\n  transition:opacity .7s cubic-bezier(.22,.61,.36,1),transform .7s cubic-bezier(.22,.61,.36,1)}\n.dpv-anim [data-reveal].is-in{opacity:1;transform:none}\n.dpv-anim .dpv-hero-col{opacity:0;transform:translateY(16px);\n  animation:dpvHeroIn .8s cubic-bezier(.22,.61,.36,1) .15s forwards}\n@keyframes dpvHeroIn{to{opacity:1;transform:none}}\n\n@media (max-width:1024px){\n  .dpv-g4{grid-template-columns:repeat(2,1fr)}\n  .dpv-trust ul{grid-template-columns:repeat(2,1fr)}\n  .dpv-trust li:nth-child(3){border-left:0}\n  .dpv-trust li:nth-child(n+3){border-top:1px solid var(--line)}\n}\n@media (max-width:860px){\n  .dpv-home{padding-bottom:64px}\n  .dpv-wrap{padding:48px 20px 0}\n  .dpv-hero{height:480px}\n  .dpv-hero h1{font-size:30px}\n  .dpv-hero-sub{font-size:14.5px;margin-bottom:22px}\n  .dpv-hero-body{padding:0 20px 56px}\n  .dpv-head h2{font-size:18px}\n  .dpv-lead{margin-top:-14px}\n  .dpv-trust{padding:0 20px}\n  .dpv-trust ul{grid-template-columns:minmax(0,1fr);margin-top:-28px}\n  .dpv-trust li{border-left:0;border-top:1px solid var(--line);padding:14px 16px}\n  .dpv-trust li:first-child{border-top:0}\n  .dpv-intro,.dpv-faq{grid-template-columns:minmax(0,1fr);gap:20px}\n  .dpv-intro h2{font-size:22px}\n  .dpv-prodrow{grid-template-columns:minmax(0,1fr)}\n  .dpv-g2,.dpv-g3,.dpv-g4{grid-template-columns:minmax(0,1fr)}\n  .dpv-card{padding:20px}\n  .dpv-about{grid-template-columns:minmax(0,1fr)}\n  .dpv-about-txt{border-radius:18px 18px 0 0;padding:28px 20px;min-height:0}\n  .dpv-about-txt>div{padding-left:0}\n  .dpv-about-txt h2{font-size:22px}\n  .dpv-about-img{border-radius:0 0 18px 18px;min-height:260px}\n  .dpv-b2b-compact .dpv-about-txt{min-height:0}\n  .dpv-b2b-compact .dpv-about-img{min-height:220px}\n  .dpv-rev-title{font-size:19px}\n  .dpv-rev{grid-template-columns:minmax(0,1fr);gap:18px}\n  .dpv-rev blockquote p{font-size:16px}\n  .dpv-final{margin:48px 20px 0;min-height:340px}\n  .dpv-final-body{padding:28px 20px}\n  .dpv-final h2{font-size:24px}\n}\n@media (prefers-reduced-motion:reduce){\n  .dpv-anim [data-reveal]{opacity:1;transform:none;transition:none}\n  .dpv-anim .dpv-hero-col{opacity:1;transform:none;animation:none}\n}\n</style>\n\n<div class=\"dpv-home\">\n\n<section class=\"dpv-hero\">\n  <img data-skip-lazy class=\"skip-lazy no-lazyload dpv-img\" src=\"/wp-content/uploads/2025/05/52a59f90-fec7-40b7-a816-61c4fadf6b13-2-min.jpg\" alt=\"Groep spelers met laserguns tijdens een lasergame in het bos\" fetchpriority=\"high\" style=\"object-position:50% 40%\">\n  <div class=\"dpv-hero-scrim\"></div>\n  <div class=\"dpv-hero-body\"><div class=\"dpv-hero-inner\"><div class=\"dpv-hero-col\">\n    <div class=\"dpv-eyebrow\">Lasergame · Compact & XL</div>\n    <h1>Lasergame huren,<br>thuis of op locatie</h1>\n    <p class=\"dpv-hero-sub\">Kies een set die bij je groep past en speel binnen een paar minuten. Geen borg, gratis afhalen in Fochteloo of verzonden met DHL.</p>\n    <div class=\"dpv-cta-row\">\n      <a class=\"dpv-btn\" href=\"#lasergames\" data-scroll=\"lasergames\">Bekijk lasergames</a>\n      \n    </div>\n  </div></div></div>\n</section>\n\n<section class=\"dpv-trust\" aria-label=\"Voordelen\"><ul><li><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z\"/><path d=\"m9 12 2 2 4-4\"/></svg><div><strong>Geen borg</strong><small>Je betaalt alleen de huurprijs</small></div></li><li><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><div><strong>Gratis afhalen in Fochteloo</strong><small>Vanaf 16:00 de dag voor je event</small></div></li><li><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6h11v9H3z\"/><path d=\"M14 9h4l3 3v3h-7\"/><circle cx=\"7\" cy=\"17.5\" r=\"1.8\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.8\"/></svg><div><strong>Levering in heel Nederland</strong><small>Verzonden met DHL</small></div></li><li><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 11h16v9H4z\"/><path d=\"M3 7h18v4H3z\"/><path d=\"M12 7v13\"/><path d=\"M12 7c-1.5-3-5-3-5-.8C7 7 9 7 12 7Zm0 0c1.5-3 5-3 5-.8C17 7 15 7 12 7Z\"/></svg><div><strong>Gratis verzending vanaf €150</strong><small>Met DHL, bij een besteding vanaf €150</small></div></li></ul></section>\n\n<section class=\"dpv-wrap\" id=\"lasergames\" data-reveal>\n<div class=\"dpv-head\"><h2>Kies je lasergame</h2><a href=\"/product-category/activiteiten-attracties-huren/attracties-activiteiten-huren/\">Alle lasergame-producten →</a></div><p class=\"dpv-lead\">Twee sets die op dezelfde manier werken. Het verschil zit in de speelduur per ronde.</p>\n<div class=\"dpv-prodrow\">\n  <slot name=\"prods\"></slot>\n  <div class=\"dpv-card dpv-card-soft\">\n    <h3>Bij beide sets</h3>\n    <ul class=\"dpv-checks\"><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Binnen 5 minuten speelklaar</span></li><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Binnen en buiten te spelen</span></li><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Geschikt vanaf 6 jaar</span></li><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Geen borg — je betaalt alleen de huurprijs</span></li></ul>\n    <a class=\"dpv-card-link\" href=\"/product-category/activiteiten-attracties-huren/attracties-activiteiten-huren/\">Bekijk ook de bundels en accessoires →</a>\n  </div>\n</div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-head\"><h2>Welke set past bij jouw groep?</h2></div><div class=\"dpv-grid dpv-g3\"><a class=\"dpv-card\" href=\"/product/lasergame-compacte-huren/\"><span class=\"dpv-pick-tag\">Lasergame Compact</span><h3>Kinderfeestje of kleinere groep</h3><p>Kleiner en voordeliger. De guns hebben drie balken met levens, dus rondes zijn kort en vol actie. Handig voor thuis, in de tuin of een grote ruimte binnen.</p><span class=\"dpv-card-link\">Bekijk Lasergame Compact →</span></a><a class=\"dpv-card\" href=\"/product/lasergame-xl-huren/\"><span class=\"dpv-pick-tag\">Lasergame XL</span><h3>Grotere groep of langer spel</h3><p>Vier balken met levens, dus een uitgebreider spel per ronde. Fijn voor tieners, volwassenen en bedrijfsuitjes op een veld, in een park of in een hal.</p><span class=\"dpv-card-link\">Bekijk Lasergame XL →</span></a><a class=\"dpv-card dpv-card-soft\" href=\"tel:0852129150\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z\"/></svg><h3>Twijfel je nog?</h3><p>Vertel ons hoe groot je groep is en waar je speelt, dan denken we mee. Bel 085 212 9150, ma–za van 9:00 tot 21:00.</p><span class=\"dpv-card-link\">Bel ons →</span></a></div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-head\"><h2>Voor elke gelegenheid</h2></div><div class=\"dpv-grid dpv-g4\"><a class=\"dpv-card\" href=\"/kinderfeestje/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20h16v-7H4z\"/><path d=\"M4 16c2 1 3-1 4 0s2 1 4 0 2-1 4 0 3 1 4 0\"/><path d=\"M12 13V9\"/><path d=\"M12 6.5c.8-.8.8-1.7 0-2.5-.8.8-.8 1.7 0 2.5Z\"/></svg><h3>Kinderfeestje</h3><p>Vanaf 6 jaar speelt iedereen mee. Combineer het met andere activiteiten voor een compleet feest.</p><span class=\"dpv-card-link\">Kinderfeestje regelen →</span></a><div class=\"dpv-card\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\"/><circle cx=\"17\" cy=\"9\" r=\"2.4\"/><path d=\"M15.5 14.2c3 .2 5.5 2.6 5.5 5.8\"/></svg><h3>Verjaardag of vriendengroep</h3><p>In de tuin, in het park of op een veld: jij kiest waar je speelt en hoe fanatiek het wordt.</p></div><a class=\"dpv-card\" href=\"/zakelijk/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18v12H3z\"/><path d=\"M8 8V5h8v3\"/><path d=\"M3 13h18\"/></svg><h3>Bedrijfsuitje</h3><p>Een actieve teamactiviteit zonder begeleiding: iedereen kan direct meedoen.</p><span class=\"dpv-card-link\">Zakelijk huren →</span></a><a class=\"dpv-card\" href=\"/zakelijk/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 4 10 5-10 5L2 9l10-5Z\"/><path d=\"M6 11v5c3 2.5 9 2.5 12 0v-5\"/></svg><h3>School, sportdag of vereniging</h3><p>Binnen één werkdag een vaste prijs en betalen op factuur. We denken mee over de planning.</p><span class=\"dpv-card-link\">Zakelijke prijs aanvragen →</span></a></div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-head\"><h2>Zo werkt huren</h2></div><div class=\"dpv-grid dpv-g4\"><div class=\"dpv-card dpv-step\"><div class=\"dpv-step-n\">1</div><h3>Kies je set</h3><p>Compact of XL, en hoeveel je nodig hebt. Zet alles in je winkelwagen.</p></div><div class=\"dpv-card dpv-step\"><div class=\"dpv-step-n\">2</div><h3>Kies je datum</h3><p>Bij het afrekenen kies je je eventdatum. Je betaalt de dagprijs voor die dag.</p></div><div class=\"dpv-card dpv-step\"><div class=\"dpv-step-n\">3</div><h3>Levering of afhalen</h3><p>Wij bezorgen in Noord-Nederland, DHL levert in heel Nederland, of je haalt gratis af in Fochteloo.</p></div><div class=\"dpv-card dpv-step\"><div class=\"dpv-step-n\">4</div><h3>Retour</h3><p>Lever alles compleet en droog in tot 16:00 de dag na je event, of zet het klaar om op te halen.</p></div></div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-head\"><h2>Lasergame huren in Noord-Nederland</h2></div><p class=\"dpv-lead\">In Friesland, Drenthe en Groningen bezorgen we ook zelf. Kies je provincie voor bezorging, afhalen en veelgestelde vragen bij jou in de buurt.</p><div class=\"dpv-grid dpv-g3\"><a class=\"dpv-card dpv-place\" href=\"/lasergame-huren-friesland/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><div><strong>Friesland</strong><small>Lasergame huren in Friesland</small></div><span class=\"dpv-arr\">→</span></a><a class=\"dpv-card dpv-place\" href=\"/lasergame-huren-drenthe/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><div><strong>Drenthe</strong><small>Lasergame huren in Drenthe</small></div><span class=\"dpv-arr\">→</span></a><a class=\"dpv-card dpv-place\" href=\"/lasergame-huren-groningen/\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><div><strong>Groningen</strong><small>Lasergame huren in Groningen</small></div><span class=\"dpv-arr\">→</span></a></div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-about\">\n  <div class=\"dpv-about-txt\"><div>\n    <div class=\"dpv-kicker\">Zakelijk</div>\n    <h2>Voor bedrijven, scholen en verenigingen</h2>\n    <p>Organiseer je een teamuitje, sportdag of clubactiviteit? Vertel ons wat je nodig hebt en vraag een zakelijke prijs aan.</p>\n    <ul class=\"dpv-checks\"><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Binnen één werkdag een vaste prijs, inclusief bezorgen en ophalen</span></li><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Betalen op factuur, met je eigen referentie of PO-nummer</span></li><li><svg class=\"dpv-ic\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"/></svg><span>Alle prijzen inclusief 21% btw, apart op je factuur</span></li></ul>\n    <a class=\"dpv-link-dark\" href=\"/zakelijk/\">Zakelijke aanvraag doen →</a>\n  </div></div>\n  <div class=\"dpv-about-img\"><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-img\" src=\"/wp-content/uploads/2025/03/IMG_3620-min-768x1024.jpg\" alt=\"Groep speelt lasergame op een grasveld met pallets als dekking\" loading=\"lazy\"></div>\n</div>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<h2 class=\"dpv-rev-title\">Ervaringen van onze klanten</h2><p class=\"dpv-rev-sub\">Gemiddeld 4,8 op Google</p>\n<figure class=\"dpv-rev\">\n  <div class=\"dpv-rev-photo\"><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-img\" src=\"/wp-content/uploads/2025/09/F4E27435-5E6B-4CE1-A3FA-FB4B5AE65C54.jpeg\" alt=\"Collega&#x27;s in actie tijdens een lasergame op een bedrijfsuitje\" loading=\"lazy\"></div>\n  <div><div class=\"dpv-stars\">★ ★ ★ ★ ★</div>\n    <blockquote><p>“Super goede service en heel handig geregeld. Mooi dat het zo kan.”</p></blockquote>\n    <figcaption><cite>Jurgen Elshof — bedrijfsuitje lasergame</cite></figcaption></div>\n</figure>\n</section>\n\n<section class=\"dpv-wrap\" data-reveal>\n<div class=\"dpv-faq\">\n  <div class=\"dpv-faq-side\"><h2>Veelgestelde vragen</h2><p>Staat je vraag er niet bij? Bel ons binnen openingstijden. Spoed buiten openingstijden? Stuur een WhatsApp.</p><div class=\"dpv-contact\">\n  <a href=\"tel:0852129150\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z\"/></svg><div><strong>Bel 085 212 9150</strong><small>Ma–za 9:00–21:00</small></div></a>\n  <a href=\"https://wa.me/31636161518\"><svg class=\"dpv-ic\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 5h16v11H9l-5 4V5Z\"/></svg><div><strong>WhatsApp bij spoed</strong><small>06 36 16 15 18 · buiten openingstijden</small></div></a>\n</div></div>\n  <div><details class=\"dpv-qa\"><summary>Wat is het verschil tussen Compact en XL?</summary><div class=\"dpv-qa-a\">Beide sets werken op dezelfde manier. De Compact guns hebben drie balken met levens, de XL guns vier. Compact is kleiner en voordeliger en ideaal voor snelle spellen; XL geeft een uitgebreider spel per ronde.</div></details><details class=\"dpv-qa\"><summary>Vanaf welke leeftijd is lasergame geschikt?</summary><div class=\"dpv-qa-a\">Vanaf 6 jaar. Kinderen, tieners en volwassenen kunnen meedoen zonder ervaring.</div></details><details class=\"dpv-qa\"><summary>Betaal ik borg?</summary><div class=\"dpv-qa-a\">Nee, we vragen op dit moment geen borg. Je hoeft dus niets vooruit te betalen dat je later terugkrijgt.</div></details><details class=\"dpv-qa\"><summary>Wat kost bezorgen?</summary><div class=\"dpv-qa-a\">Lasergames versturen we met DHL door heel Nederland: €16 per pakket, gratis vanaf €150. In Noord-Nederland bezorgen we ook zelf. Het tarief en de gratis-grens hangen af van je zone. <a href=\"/contact/\">Bereken het met je postcode</a>. Zelf afhalen in Fochteloo is altijd gratis.</div></details><details class=\"dpv-qa\"><summary>Kan ik binnen en buiten spelen?</summary><div class=\"dpv-qa-a\">Ja. Speel in de tuin, in een park, op een veld of binnen in een grote ruimte of hal.</div></details><details class=\"dpv-qa\"><summary>Kan ik annuleren of mijn datum wijzigen?</summary><div class=\"dpv-qa-a\">Wijzigen of annuleren kan kosteloos tot 72 uur voor je huurdatum. Daarna rekenen we 100% van het huurbedrag, inclusief verzend- en bezorgkosten.</div></details></div>\n</div>\n</section>\n\n<section class=\"dpv-final\" data-reveal>\n  <img data-skip-lazy class=\"skip-lazy no-lazyload dpv-img\" src=\"/wp-content/uploads/2026/02/Ontwerp-zonder-titel_11zon.webp\" alt=\"Spelers met laserguns verstoppen zich achter de struiken in een tuin\" loading=\"lazy\">\n  <div class=\"dpv-hero-scrim\"></div>\n  <div class=\"dpv-final-body\">\n    <h2>Klaar voor een potje lasergame?</h2><p>Kies je set, kies je datum en wij regelen de rest. Geen borg, gratis DHL-verzending vanaf €150.</p>\n    <div class=\"dpv-cta-row\"><a class=\"dpv-btn\" href=\"#lasergames\" data-scroll=\"lasergames\">Bekijk lasergames</a>\n      <a class=\"dpv-link-ul\" href=\"tel:0852129150\">Of bel 085 212 9150</a></div>\n    <div class=\"dpv-final-links\"><a href=\"/product/lasergame-compacte-huren/\">Lasergame Compact</a><a href=\"/product/lasergame-xl-huren/\">Lasergame XL</a></div>\n  </div>\n</section>\n\n</div>\n</template>\n\n<script>\n(function(){\n  var host=document.getElementById('dpv-rg-host'),\n      tpl=document.getElementById('dpv-rg-tpl'),\n      grid=document.getElementById('dpv-rg-prods');\n  if(!host||!tpl||host.dataset.dpvInit)return; host.dataset.dpvInit='1';\n\n  /* Ontwerp in een shadow root, net als de homepage. */\n  var root=host.attachShadow?host.attachShadow({mode:'open'}):host;\n  root.appendChild(tpl.content.cloneNode(true));\n  if(grid)host.appendChild(grid);            /* slot=\"prods\" */\n  tpl.remove();\n\n  /* WhatsApp-tracking-bridge — gelijk aan header/footer/klantenservice:\n     een klik op een wa.me-link in de shadow root wordt doorgegeven aan een\n     verborgen link in de light DOM, zodat GTM en de conversietags hem zien. */\n  root.addEventListener('click',function(e){\n    var path=typeof e.composedPath==='function'?e.composedPath():[];var link=null;\n    for(var i=0;i<path.length;i++){var el=path[i];\n      if(el&&el.tagName==='A'&&el.href&&/^https:\\/\\/wa\\.me\\//i.test(el.href)){link=el;break}}\n    if(!link||e.defaultPrevented)return;\n    e.preventDefault();\n    var bridge=document.getElementById('dpv-rg-wa-bridge');\n    if(!bridge){bridge=document.createElement('a');bridge.id='dpv-rg-wa-bridge';\n      bridge.setAttribute('aria-hidden','true');bridge.tabIndex=-1;\n      bridge.style.cssText='position:fixed;left:-99999px;top:-99999px;width:1px;height:1px;overflow:hidden;';\n      document.body.appendChild(bridge)}\n    bridge.href=link.href;bridge.textContent=(link.textContent||'WhatsApp').trim();\n    if(link.rel){bridge.rel=link.rel}else{bridge.removeAttribute('rel')}\n    if(link.target){bridge.target=link.target}else if(e.ctrlKey||e.metaKey||e.shiftKey){bridge.target='_blank'}else{bridge.removeAttribute('target')}\n    bridge.click();\n  });\n\n  /* Interne ankers (#lasergames) binnen de shadow root. */\n  root.addEventListener('click',function(e){\n    var a=e.target.closest&&e.target.closest('a[data-scroll]');\n    if(!a)return;\n    var t=root.getElementById(a.getAttribute('data-scroll'));\n    if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}\n  });\n\n  /* Lazy-load-plugins komen niet in een shadow root: bronnen zelf terugzetten. */\n  var unlazy=function(scope){\n    scope.querySelectorAll('img,video,source').forEach(function(el){\n      var d=el.dataset||{};\n      var src=d.src||d.lazySrc||d.original||d.lazyOriginal||el.getAttribute('data-lazy-src');\n      if(src&&(!el.getAttribute('src')||/^data:image/.test(el.getAttribute('src'))))el.setAttribute('src',src);\n      var ss=d.srcset||d.lazySrcset||el.getAttribute('data-lazy-srcset');\n      if(ss&&!el.getAttribute('srcset'))el.setAttribute('srcset',ss);\n      el.removeAttribute('loading');\n    });\n  };\n  unlazy(root);\n\n  /* Scroll-animaties (homepage) */\n  var wrap=root.querySelector('.dpv-home'),\n      reveal=[].slice.call(root.querySelectorAll('[data-reveal]'));\n  if(wrap&&reveal.length&&'IntersectionObserver' in window){\n    wrap.classList.add('dpv-anim');\n    var io=new IntersectionObserver(function(es){\n      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});\n    },{rootMargin:'0px 0px -12% 0px',threshold:.12});\n    reveal.forEach(function(el){io.observe(el);});\n    setTimeout(function(){reveal.forEach(function(el){el.classList.add('is-in');});},3000);\n  }\n\n  if(!grid)return;\n  unlazy(grid);\n\n  /* Alt-teksten van de productfoto's (de kaarten van dpv-shop hebben alt=\"\"). */\n  var setAlts=function(){\n    var alts={};try{alts=JSON.parse(grid.dataset.alts||'{}')}catch(e){}\n    Object.keys(alts).forEach(function(id){\n      var b=grid.querySelector('[data-product=\"'+id+'\"]'),card=b&&b.closest('[data-prod-card]'),img=card&&card.querySelector('img');\n      if(img)img.setAttribute('alt',alts[id]);\n    });\n  };\n  setAlts();\n\n  /* Productkaarten actueel houden: dezelfde kaarten als op de categoriepagina\n     (prijs, badge, knop). Lukt dat niet, dan blijven de meegeleverde kaarten staan. */\n  var ids=[].map.call(grid.querySelectorAll('[data-product]'),function(b){return b.dataset.product;});\n  if(ids.length&&window.fetch&&window.DOMParser){\n    fetch(grid.dataset.src,{credentials:'same-origin'})\n      .then(function(r){return r.ok?r.text():Promise.reject(r.status);})\n      .then(function(t){\n        var doc=new DOMParser().parseFromString(t,'text/html');\n        ids.forEach(function(id){\n          var btn=doc.querySelector('[data-prod-card] [data-product=\"'+id+'\"]'),\n              mine=grid.querySelector('[data-product=\"'+id+'\"]');\n          if(!btn||!mine)return;\n          var fresh=btn.closest('[data-prod-card]'),old=mine.closest('[data-prod-card]');\n          fresh.querySelectorAll('noscript').forEach(function(n){n.remove();});\n          old.replaceWith(document.importNode(fresh,true));\n        });\n        unlazy(grid);\n        setAlts();\n      }).catch(function(){});\n  }\n\n  /* DPV Shop laden als WordPress het op deze pagina niet meestuurt (de plugin\n     enqueuet alleen op shop-/product-/vaste pagina's). Dezelfde plugin-bestanden\n     als op de shop; add-to-cart werkt zonder nonce (gecachte pagina's). Pas na\n     'load', zodat er nooit een tweede kopie naast een normaal geladen script komt. */\n  var loadShop=function(){\n    if(document.getElementById('dpv-shop-js')||window.DPVS_API)return;\n    window.DPVS=window.DPVS||{ajax:'/wp-admin/admin-ajax.php',nonce:'',cart_url:'/winkelwagen/',checkout:'/afreken-pagina/'};\n    var base='/wp-content/plugins/dpv-shop/assets/';\n    var l=document.createElement('link');l.rel='stylesheet';l.id='dpv-shop-css';l.href=base+'css/dpv-shop.css';\n    document.head.appendChild(l);\n    [['dpv-shop-js','js/dpv-shop.js'],['dpv-shop-ga4-js','js/dpv-ga4.js']].forEach(function(f){\n      var s=document.createElement('script');s.id=f[0];s.src=base+f[1];s.async=false;document.body.appendChild(s);\n    });\n  };\n  if(document.readyState==='complete')loadShop();else window.addEventListener('load',loadShop);\n\n  /* Huren-knop: dpv-shop handelt hem af zodra het script draait. Draait het\n     (nog) niet, dan gaat de knop naar de productpagina, zodat hij nooit dood is. */\n  grid.addEventListener('click',function(e){\n    var b=e.target.closest&&e.target.closest('.js-dpvs-add');\n    if(!b||window.DPVS_API)return;\n    var card=b.closest('[data-prod-card]'),a=card&&card.querySelector('a[href]');\n    if(a){e.preventDefault();e.stopPropagation();window.location.href=a.href;}\n  },true);\n})();\n</script>\n",
