g { display: block !important; font-size: 13px !important; font-weight: 700 !important; }\n.kf-page .kf-review-author span { font-size: 12px !important; color: var(--muted) !important; }\n.kf-page .kf-review-photo { border-radius: 16px !important; overflow: hidden !important; aspect-ratio: 4/3 !important; }\n.kf-page .kf-review-photo img { width: 100% !important; height: 100% !important; object-fit: cover !important; }\n.kf-page .kf-more-reviews { display: inline-flex !important; align-items: center !important; gap: 6px !important; margin-top: 18px !important; font-size: 13px !important; font-weight: 600 !important; color: var(--navy) !important; border-bottom: 1.5px solid var(--navy) !important; padding-bottom: 1px !important; transition: gap 0.2s !important; }\n.kf-page .kf-more-reviews:hover { gap: 10px !important; }\n\n.kf-page .kf-regio-sec { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-regio-blok { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 56px !important; align-items: start !important; }\n.kf-page .kf-regio-blok-left h2 { font-size: clamp(18px, 2vw, 26px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 8px !important; margin-top: 8px !important; }\n.kf-page .kf-regio-blok-left p { font-size: 13px !important; color: var(--muted) !important; line-height: 1.65 !important; max-width: 340px !important; }\n.kf-page .kf-regio-pills { display: flex !important; flex-wrap: wrap !important; gap: 7px !important; padding-top: 4px !important; }\n.kf-page .kf-regio-pill { display: inline-flex !important; align-items: center !important; gap: 5px !important; padding: 7px 13px !important; border: 1.5px solid var(--border) !important; border-radius: 999px !important; font-size: 13px !important; font-weight: 600 !important; color: var(--navy) !important; background: #fff !important; transition: background 0.18s, border-color 0.18s, transform 0.18s !important; }\n.kf-page .kf-regio-pill:hover { background: #eef2f6 !important; border-color: var(--navy) !important; transform: translateY(-1px) !important; }\n\n.kf-page .kf-faq-sec { padding: 68px 0 !important; }\n.kf-page .kf-faq-inner { display: grid !important; grid-template-columns: 260px 1fr !important; gap: 72px !important; align-items: start !important; }\n.kf-page .kf-faq-left h2 { font-size: clamp(20px, 2.2vw, 28px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 10px !important; }\n.kf-page .kf-faq-left p { font-size: 13px !important; color: var(--muted) !important; line-height: 1.65 !important; margin-bottom: 20px !important; }\n.kf-page .kf-faq-wa { display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 11px 18px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 13px !important; font-weight: 700 !important; transition: background 0.2s !important; }\n.kf-page .kf-faq-wa:hover { background: #1dba57 !important; }\n.kf-page .kf-faq-item { border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-faq-q { width: 100% !important; text-align: left !important; padding: 16px 0 !important; font-size: 14px !important; font-weight: 600 !important; color: var(--text) !important; background: none !important; border: none !important; cursor: pointer !important; display: flex !important; justify-content: space-between !important; align-items: center !important; gap: 16px !important; transition: color 0.2s !important; }\n.kf-page .kf-faq-q:hover { color: var(--navy) !important; }\n.kf-page .kf-faq-icon { width: 22px !important; height: 22px !important; border-radius: 50% !important; background: var(--off) !important; border: 1px solid var(--border) !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; font-size: 14px !important; transition: background 0.22s, transform 0.3s var(--ease), border-color 0.22s !important; color: var(--navy) !important; }\n.kf-page .kf-faq-item.open .kf-faq-icon { background: var(--navy) !important; color: #fff !important; border-color: var(--navy) !important; transform: rotate(45deg) !important; }\n.kf-page .kf-faq-a { overflow: hidden !important; max-height: 0 !important; transition: max-height 0.4s var(--ease), padding 0.3s !important; font-size: 13px !important; color: #555 !important; line-height: 1.7 !important; padding: 0 32px 0 0 !important; }\n.kf-page .kf-faq-item.open .kf-faq-a { max-height: 300px !important; padding-bottom: 16px !important; }\n\n@media (max-width: 960px) {\n  .kf-page .kf-intro-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-joris { position: static !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: repeat(2, 1fr) !important; }\n  .kf-page .kf-review-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-regio-blok { grid-template-columns: 1fr !important; gap: 20px !important; }\n  .kf-page .kf-faq-inner { grid-template-columns: 1fr !important; gap: 28px !important; }\n}\n@media (max-width: 600px) {\n  .kf-page .kf-w { padding: 0 20px !important; }\n  .kf-page .kf-hero-content { padding: 0 20px 40px !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: 1fr !important; }\n}\n</style>\n\n<div class=\"kf-page\">\n\n<section class=\"kf-hero\">\n  <div class=\"kf-hero-img\" id=\"%%PARALLAX_ID%%\"></div>\n  <div class=\"kf-hero-content\">\n    <span class=\"kf-hero-tag\">Silent disco huren · Emmen</span>\n    <h1>Silent disco huren<br><em>in Emmen.</em></h1>\n    <div class=\"kf-hero-meta\">\n      <a href=\"/product-category/geluid/\" class=\"kf-hero-cta\">Bekijk silent disco &#x2192;</a>\n      <span class=\"kf-hero-pill\">&#x2713; Bezorgd in Emmen</span><span class=\"kf-hero-pill\">&#x2713; Geen borg</span><span class=\"kf-hero-pill\">&#x2713; DHL heel Nederland</span>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-intro\">\n  <div class=\"kf-w\">\n    <div class=\"kf-intro-inner\">\n      <div class=\"kf-intro-left\">\n        <span class=\"kf-eyebrow sr\">Silent disco huren in Emmen</span>\n        <h2 class=\"sr sr-d1\">Silent disco huren in Emmen — bezorgd aan huis</h2>\n        <p class=\"sr sr-d2\">Silent disco huren in Emmen doe je bij DagpakketVerhuur. Iedereen danst op zijn eigen muziek via een draadloze koptelefoon — geen geluidsoverlast, geen vergunningsproblemen. Kant-en-klaar bezorgd in Emmen en de omliggende plaatsen.</p><p class=\"sr sr-d3\">Geen borg, geen gedoe. Wij leveren alles inclusief zenders en instructies. Na gebruik stuur je het terug via DHL of halen wij het op. Gratis bezorging in Drenthe vanaf €150 besteding.</p><p class=\"sr sr-d4\">Silent disco is geschikt voor elk evenement — van een intiem verjaardagsfeestje tot een grote bruiloft. Wil je het combineren met een partytent of statafels? Bestel alles tegelijk via de webshop.</p>\n      </div>\n      <div class=\"kf-joris sr sr-right sr-d2\">\n        <div class=\"kf-joris-img\">\n          <img src=\"https://dagpakketverhuur.nl/wp-content/uploads/2025/03/IMG_1962-1-scaled.jpg\" alt=\"Joris van DagpakketVerhuur\" loading=\"lazy\">\n        </div>\n        <div class=\"kf-joris-body\">\n          <p class=\"kf-joris-quote\">Silent disco is altijd een verrassing voor gasten. Ze zetten de koptelefoon op en weten niet wat ze meemaken — ik vertel het ze liever niet, zodat de reactie des te beter is.</p>\n          <div class=\"kf-joris-name\">\n            <div class=\"kf-joris-avatar\">J</div>\n            <div class=\"kf-joris-info\"><strong>Joris</strong><span>Oprichter DagpakketVerhuur</span></div>\n          </div>\n          <a href=\"https://wa.me/31852129150\" class=\"kf-joris-wa\">&#x1F4AC; WhatsApp Joris direct</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-gel-sec\">\n  <div class=\"kf-w\">\n    <span class=\"kf-eyebrow sr\">Perfect voor</span>\n    <h2 class=\"sr sr-d1\">Silent disco in Emmen past bij elk evenement</h2>\n    <p class=\"sr sr-d2\">Silent disco werkt op elk evenement — binnen en buiten, klein en groot.</p>\n    <div class=\"kf-gel-grid\">\n      <a href=\"/kinderfeestje/\" class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F382;</span>\n        <strong>Kinderfeestje</strong>\n        <span>Kids dansen op hun eigen muziek via koptelefoons. Uniek, rustig voor de buurt en onvergetelijk leuk.</span>\n      </a>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F492;</span>\n        <strong>Bruiloft</strong>\n        <span>Dansen tot laat zonder geluidsoverlast. Ieder danst op zijn eigen kanaal — van pop tot latin.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F4BC;</span>\n        <strong>Bedrijfsfeest</strong>\n        <span>Unieke en interactieve entertainment voor collega&#x2019;s. Iedereen doet mee, niemand hoeft te schreeuwen.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F38A;</span>\n        <strong>Verjaardag &amp; feest</strong>\n        <span>Van tieners tot volwassenen — silent disco is altijd een verrassing en gegarandeerd een hit.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F3D8;&#xFE0F;</span>\n        <strong>Buurtfeest &amp; festival</strong>\n        <span>Geen geluidsoverlast, geen vergunningsproblemen. Perfect voor buiten evenementen in Emmen.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F393;</span>\n        <strong>Schoolfeest &amp; vereniging</strong>\n        <span>Interactief en veilig voor alle leeftijden. Meerdere kanalen zodat iedereen zijn eigen muziek kiest.</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-review\">\n  <div class=\"kf-w\">\n    <div class=\"kf-review-inner\">\n      <div class=\"kf-review-text sr sr-left\">\n        <div class=\"kf-stars\">&#x2605;&#x2605;&#x2605;&#x2605;&#x2605;</div>\n        <p class=\"kf-review-quote\">&#x201C;Onze gasten wisten niet wat ze meemaakten toen ze de koptelefoon opzetten. Silent disco was veruit het leukste onderdeel van ons feest. Snel bezorgd, alles werkte perfect.&#x201D;</p>\n        <div class=\"kf-review-author\">\n          <div class=\"kf-review-avatar\">A</div>\n          <div><strong>Anne-Marie D.</strong><span>Geverifieerde huurder · Emmen</span></div>\n        </div>\n        <a href=\"https://g.page/r/dagpakketverhuur/review\" class=\"kf-more-reviews\">Bekijk alle 25+ reviews &#x2192;</a>\n      </div>\n      <div class=\"kf-review-photo sr sr-right sr-d1\">\n        <img src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/02/unnamed-1_11zon.webp\" alt=\"Silent disco huren Emmen - DagpakketVerhuur\" loading=\"lazy\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-regio-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-regio-blok sr\">\n      <div class=\"kf-regio-blok-left\">\n        <span class=\"kf-eyebrow\">Silent disco per regio</span>\n        <h2>Silent disco huren in een andere regio?</h2>\n        <p>Via DHL bezorgen we door heel Nederland. Of kies een andere regio in Noord-Nederland:</p>\n      </div>\n      <div>\n        <div class=\"kf-regio-pills\"><a href=\"/silent-disco-huren/\" class=\"kf-regio-pill\">🇳🇱 Heel Nederland</a><a href=\"/silent-disco-huren-friesland/\" class=\"kf-regio-pill\">📍 Friesland</a><a href=\"/silent-disco-huren-drenthe/\" class=\"kf-regio-pill\">📍 Drenthe</a><a href=\"/silent-disco-huren-groningen/\" class=\"kf-regio-pill\">📍 Groningen</a><a href=\"/silent-disco-huren-assen/\" class=\"kf-regio-pill\">📍 Assen</a><a href=\"/silent-disco-huren-leeuwarden/\" class=\"kf-regio-pill\">📍 Leeuwarden</a><a href=\"/kinderfeestje-emmen/\" class=\"kf-regio-pill\">🎂 Kinderfeestje Emmen</a></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-faq-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-faq-inner\">\n      <div class=\"kf-faq-left sr sr-left\">\n        <span class=\"kf-eyebrow\">Vragen?</span>\n        <h2>Veelgestelde vragen</h2>\n        <p>Staat jouw vraag er niet bij? App Joris direct.</p>\n        <a href=\"https://wa.me/31852129150\" class=\"kf-faq-wa\">&#x1F4AC; WhatsApp Joris</a>\n      </div>\n      <div class=\"kf-faq-list sr sr-d1\">\n        <div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Bezorgen jullie silent disco gratis in Emmen?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Ja, wij versturen silent disco sets via DHL door heel Nederland — inclusief retourlabel. In Emmen en de rest van Noord-Nederland bezorgen we ook persoonlijk aan huis. Gratis bezorging in Drenthe vanaf €150 besteding.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Hoeveel koptelefoons zitten er in een set?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Dat verschilt per pakket. We verhuren sets van verschillende groottes, afhankelijk van de groepsgrootte. Twijfel je hoeveel koptelefoons je nodig hebt voor jouw evenement? Stuur een WhatsApp en Joris denkt mee.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Hoeveel kanalen heeft de silent disco set?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Onze silent disco sets werken met meerdere kanalen — zo kan iedereen zelf kiezen op welke muziek ze dansen. Ideaal voor evenementen met gemengde doelgroepen of verschillende muzieksmaken.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Is er een borgsom bij silent disco huren?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Nee, wij vragen geen borg. Je betaalt alleen de huurprijs — geen verborgen kosten en geen verrassingen achteraf. Na gebruik stuur je alles terug via het meegeleverde DHL retourlabel, of wij halen het op in Emmen en omgeving.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Hoe ver van tevoren moet ik reserveren?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">We adviseren minimaal 3 tot 5 dagen van tevoren te reserveren, zeker in drukke periodes zoals zomervakantie en weekenden. Check altijd eerst de beschikbaarheid in de webshop. Last-minute is soms mogelijk — stuur een WhatsApp en Joris kijkt wat er kan.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Kan ik silent disco combineren met andere huurartikelen?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Zeker. Veel klanten combineren silent disco met een partytent, statafels of funfood voor een compleet feest. Je bestelt alles tegelijk via de webshop — wij bezorgen het in één keer. Twijfel je wat goed past bij jouw evenement in Emmen? App Joris even.</div></div>\n\n      </div>\n    </div>\n  </div>\n</section>\n\n</div>\n\n<script>\n(function(){\n  var io=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add(\"in\");io.unobserve(e.target);}});},{threshold:0.1});\n  document.querySelectorAll(\".kf-page .sr\").forEach(function(el){io.observe(el);});\n  var p=document.getElementById(\"%%PARALLAX_ID%%\");\n  if(p)window.addEventListener(\"scroll\",function(){p.style.transform=\"scale(1.08) translateY(\"+(window.scrollY*.24)+\"px)\";},{passive:true});\n  document.querySelectorAll(\".kf-page .kf-faq-q\").forEach(function(btn){\n    btn.addEventListener(\"click\",function(){\n      var item=this.closest(\".kf-faq-item\"),open=item.classList.contains(\"open\");\n      document.querySelectorAll(\".kf-page .kf-faq-item\").forEach(function(i){i.classList.remove(\"open\");});\n      if(!open)item.classList.add(\"open\");\n    });\n  });\n})();\n</script>",
