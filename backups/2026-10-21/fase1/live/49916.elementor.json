    "settings": {
     "html": "<style>\n.elementor-widget-html > .elementor-widget-container { padding: 0 !important; margin: 0 !important; max-width: none !important; }\n.elementor-element:has(.elementor-widget-html > .elementor-widget-container > .kf-page) { max-width: none !important; width: 100vw !important; margin-left: calc(50% - 50vw) !important; margin-right: calc(50% - 50vw) !important; padding-left: 0 !important; padding-right: 0 !important; }\n.elementor-element:has(.kf-page) > .elementor-widget-wrap, .elementor-element:has(.kf-page) > .elementor-container, .elementor-element:has(.kf-page) > .e-con-inner { max-width: none !important; width: 100% !important; }\n\n.kf-page { --navy: #2f4156; --text: #1a1a1a; --muted: #6b6b6b; --white: #ffffff; --off: #f7f7f5; --border: #e8e8e4; --gold: #f5a623; --sans: -apple-system, BlinkMacSystemFont, \"DM Sans\", \"Segoe UI\", sans-serif; --ease: cubic-bezier(.4,0,.2,1); font-family: var(--sans) !important; font-size: 15px !important; line-height: 1.6 !important; color: var(--text) !important; background: var(--white) !important; -webkit-font-smoothing: antialiased !important; width: 100% !important; display: block !important; position: relative !important; overflow-x: hidden !important; }\n.kf-page *, .kf-page *::before, .kf-page *::after { box-sizing: border-box !important; margin: 0 !important; padding: 0 !important; line-height: inherit !important; }\n.kf-page a { text-decoration: none !important; color: inherit !important; }\n.kf-page img { display: block !important; max-width: 100% !important; }\n.kf-page button { font-family: var(--sans) !important; }\n\n.kf-page .sr { opacity: 0 !important; transform: translateY(24px) !important; transition: opacity 0.6s var(--ease), transform 0.6s var(--ease) !important; }\n.kf-page .sr.sr-left { transform: translateX(-24px) !important; }\n.kf-page .sr.sr-right { transform: translateX(24px) !important; }\n.kf-page .sr.in { opacity: 1 !important; transform: none !important; }\n.kf-page .sr-d1 { transition-delay: 0.08s !important; }\n.kf-page .sr-d2 { transition-delay: 0.16s !important; }\n.kf-page .sr-d3 { transition-delay: 0.24s !important; }\n\n.kf-page .kf-w { max-width: 1160px !important; margin: 0 auto !important; padding: 0 32px !important; }\n.kf-page .kf-eyebrow { font-size: 11px !important; font-weight: 700 !important; letter-spacing: 0.13em !important; text-transform: uppercase !important; color: var(--navy) !important; display: block !important; margin-bottom: 10px !important; }\n\n.kf-page .kf-hero { position: relative !important; height: 88vh !important; min-height: 520px !important; max-height: 780px !important; overflow: hidden !important; display: flex !important; align-items: flex-end !important; }\n.kf-page .kf-hero-img { position: absolute !important; inset: 0 !important; background: linear-gradient(to bottom, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.54) 68%, rgba(0,0,0,0.78) 100%), url(\"https://dagpakketverhuur.nl/wp-content/uploads/2026/02/unnamed-1_11zon.webp\") center/cover no-repeat !important; transform: scale(1.08) !important; }\n.kf-page .kf-hero-content { position: relative !important; z-index: 2 !important; width: 100% !important; padding: 0 48px 56px !important; max-width: 1160px !important; margin: 0 auto !important; }\n.kf-page .kf-hero-tag { display: inline-block !important; font-size: 11px !important; font-weight: 700 !important; letter-spacing: 0.14em !important; text-transform: uppercase !important; color: rgba(255,255,255,0.5) !important; margin-bottom: 12px !important; }\n.kf-page .kf-hero h1 { font-size: clamp(34px, 5.5vw, 68px) !important; font-weight: 800 !important; color: #fff !important; line-height: 1.03 !important; letter-spacing: -0.04em !important; margin-bottom: 20px !important; max-width: 720px !important; }\n.kf-page .kf-hero h1 em { font-style: italic !important; font-weight: 400 !important; color: rgba(255,255,255,0.75) !important; }\n.kf-page .kf-hero-meta { display: flex !important; align-items: center !important; gap: 10px !important; flex-wrap: wrap !important; }\n.kf-page .kf-hero-pill { display: inline-flex !important; align-items: center !important; padding: 8px 15px !important; border-radius: 999px !important; background: rgba(255,255,255,0.12) !important; border: 1px solid rgba(255,255,255,0.18) !important; color: rgba(255,255,255,0.9) !important; font-size: 13px !important; font-weight: 600 !important; backdrop-filter: blur(6px) !important; }\n.kf-page .kf-hero-cta { display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 13px 26px !important; background: #fff !important; color: var(--navy) !important; border-radius: 10px !important; font-size: 14px !important; font-weight: 700 !important; transition: background 0.2s, transform 0.2s !important; }\n.kf-page .kf-hero-cta:hover { background: #f0f0ee !important; transform: translateY(-1px) !important; }\n\n.kf-page .kf-intro { padding: 76px 0 68px !important; border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-intro-inner { display: grid !important; grid-template-columns: 1fr 380px !important; gap: 72px !important; align-items: start !important; }\n.kf-page .kf-intro-left h2 { font-size: clamp(24px, 3.2vw, 40px) !important; font-weight: 800 !important; line-height: 1.08 !important; letter-spacing: -0.035em !important; margin-bottom: 20px !important; }\n.kf-page .kf-intro-left p { font-size: 15px !important; color: #444 !important; line-height: 1.75 !important; margin-bottom: 16px !important; max-width: 500px !important; }\n.kf-page .kf-joris { background: var(--off) !important; border: 1px solid var(--border) !important; border-radius: 18px !important; overflow: hidden !important; position: sticky !important; top: 100px !important; }\n.kf-page .kf-joris-img { width: 100% !important; aspect-ratio: 4/3 !important; overflow: hidden !important; }\n.kf-page .kf-joris-img img { width: 100% !important; height: 100% !important; object-fit: cover !important; }\n.kf-page .kf-joris-body { padding: 20px 22px 24px !important; }\n.kf-page .kf-joris-quote { font-size: 14px !important; line-height: 1.68 !important; font-style: italic !important; margin-bottom: 16px !important; position: relative !important; padding-left: 14px !important; color: var(--text) !important; }\n.kf-page .kf-joris-quote::before { content: \"\" !important; position: absolute !important; left: 0 !important; top: 4px !important; bottom: 4px !important; width: 3px !important; background: var(--navy) !important; border-radius: 2px !important; }\n.kf-page .kf-joris-name { display: flex !important; align-items: center !important; gap: 10px !important; }\n.kf-page .kf-joris-avatar { width: 36px !important; height: 36px !important; border-radius: 50% !important; background: var(--navy) !important; display: flex !important; align-items: center !important; justify-content: center !important; color: #fff !important; font-size: 14px !important; font-weight: 700 !important; flex-shrink: 0 !important; }\n.kf-page .kf-joris-info strong { display: block !important; font-size: 13px !important; font-weight: 700 !important; }\n.kf-page .kf-joris-info span { font-size: 12px !important; color: var(--muted) !important; }\n.kf-page .kf-joris-wa { display: flex !important; align-items: center !important; gap: 8px !important; margin-top: 16px !important; padding: 11px 15px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 13px !important; font-weight: 700 !important; transition: background 0.2s !important; }\n.kf-page .kf-joris-wa:hover { background: #1dba57 !important; }\n\n.kf-page .kf-gel-sec { padding: 68px 0 !important; border-bottom: 1px solid var(--border) !important; background: var(--off) !important; }\n.kf-page .kf-gel-sec h2 { font-size: clamp(20px, 2.4vw, 30px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 8px !important; }\n.kf-page .kf-gel-sec > .kf-w > p { font-size: 14