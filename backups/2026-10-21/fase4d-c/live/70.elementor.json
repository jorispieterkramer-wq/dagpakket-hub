   {
    "id": "36a5a0d",
    "elType": "widget",
    "settings": {
     "html": "<!--\n  ============================================================\n  DAGPAKKETVERHUUR — OVER ONS\n  Eén Elementor HTML-widget in een sectie, volle breedte, padding 0.\n  ------------------------------------------------------------\n  Dit blok rendert in een SHADOW ROOT. Elementor, het thema en\n  andere plugins kunnen de opmaak daarbinnen niet raken — wat je\n  hier ziet is exact wat er op de site staat.\n  ============================================================\n-->\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Lora:ital,wght@0,400;1,400;1,500&display=swap\" rel=\"stylesheet\">\n\n<div id=\"dpv-ab-host\"></div>\n\n<template id=\"dpv-ab-tpl\">\n<style>\n:host{display:block}\n*{box-sizing:border-box;margin:0;padding:0;border:0;background:none;font:inherit;color:inherit;\n  letter-spacing:normal;text-transform:none;text-decoration:none;list-style:none}\n.dpv-ab{--pri:#2f4156;--acc:#567c8d;--mut:#6b7a8d;--card:#e6e0d7;\n  font-family:Outfit,Inter,Arial,sans-serif;font-size:16px;font-weight:400;line-height:1.5;\n  background:#f5f3ef;color:var(--pri);text-wrap:pretty}\na{color:var(--pri);cursor:pointer}\na:hover{color:#1f2e3a}\nimg,video{display:block;max-width:100%}\nbutton{cursor:pointer}\n.dpv-ab-wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.dpv-ab-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n.dpv-ab-kick{font-size:12px;line-height:1;letter-spacing:1.8px;text-transform:uppercase;\n  color:var(--acc);font-weight:600;margin-bottom:18px}\nh1{font-size:46px;line-height:1.1;letter-spacing:-1px;font-weight:600;margin-bottom:34px}\nh1 em{font-family:Lora,Georgia,serif;font-style:italic;font-weight:400;letter-spacing:0}\nh2{font-size:34px;line-height:1.15;letter-spacing:-.7px;font-weight:600;margin-bottom:20px}\n.dpv-ab-lead{font-size:17px;line-height:1.75;color:var(--mut);margin-bottom:30px;max-width:600px}\n\n/* hero */\n.dpv-ab-hero{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,.94fr);\n  gap:56px;align-items:center;padding:76px 24px 48px;max-width:1180px;margin:0 auto}\n.dpv-ab-cta{display:flex;gap:22px;flex-wrap:wrap;align-items:center}\n.dpv-ab-btn{background:var(--pri);color:#fff;font-weight:600;font-size:15px;\n  padding:15px 26px;border-radius:999px;display:inline-block}\n.dpv-ab-btn:hover{background:#263646;color:#fff}\n.dpv-ab-ul{font-weight:600;font-size:15px;border-bottom:1.5px solid var(--pri);padding-bottom:2px}\n.dpv-ab-shot{position:relative}\n.dpv-ab-shot-frame{position:relative;height:500px;border-radius:28px;overflow:hidden;\n  box-shadow:0 10px 35px rgba(47,65,86,.08);background:#dfe7ee}\n.dpv-ab-badge{position:absolute;left:-18px;bottom:26px;background:rgba(255,255,255,.94);\n  border-radius:20px;padding:18px 20px;min-width:150px;box-shadow:0 10px 35px rgba(47,65,86,.08)}\n.dpv-ab-badge b{display:block;font-size:28px;line-height:1;letter-spacing:-.5px;font-weight:600}\n.dpv-ab-badge span{display:block;margin-top:6px;font-size:13px;line-height:1.4;color:var(--mut)}\n\n/* verhaal */\n.dpv-ab-story{padding:76px 24px}\n.dpv-ab-card{background:#fff;border:1px solid var(--card);border-radius:28px;padding:54px;\n  box-shadow:0 10px 35px rgba(47,65,86,.08)}\n.dpv-ab-card p{font-size:17px;line-height:1.8;color:var(--mut)}\n.dpv-ab-paras{display:flex;flex-direction:column;gap:20px}\n.dpv-ab-quote{margin:34px 0;padding:24px 28px;border-left:4px solid var(--acc);\n  background:#f4f8fa;border-radius:0 18px 18px 0}\n.dpv-ab-quote p{font-family:Lora,Georgia,serif;font-style:italic;font-size:24px;\n  line-height:1.6;color:var(--pri)}\n.dpv-ab-award{display:inline-flex;align-items:center;gap:12px;padding:14px 18px;border-radius:999px;\n  background:#f7f5f1;border:1px solid var(--card);font-size:14px;font-weight:600;line-height:1.4}\n.dpv-ab-award i{width:34px;height:34px;border-radius:999px;background:rgba(86,124,141,.12);\n  display:inline-flex;align-items:center;justify-content:center;flex:0 0 34px;\n  color:var(--acc);font-size:15px;font-style:normal}\n\n/* pers */\n.dpv-ab-press-sec{padding:0 24px 76px;text-align:center;max-width:1180px;margin:0 auto}\n.dpv-ab-press{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:22px;\n  max-width:920px;margin:0 auto}\n.dpv-ab-press>div{min-height:132px;border-radius:24px;border:1px solid var(--card);\n  background:rgba(255,255,255,.82);display:flex;align-items:center;\n  justify-content:center;padding:26px;box-shadow:0 8px 24px rgba(47,65,86,.04)}\n.dpv-ab-press-slot{position:relative;width:100%;height:80px}\n.dpv-ab-press-slot img{object-fit:contain;padding:8px}\n.dpv-ab-press-slot[data-groot] img{padding:0;transform:scale(1.5)}\n\n/* community */\n.dpv-ab-com-sec{padding:0 24px 92px;text-align:center;max-width:1180px;margin:0 auto}\n.dpv-ab-hash{font-family:Lora,Georgia,serif;font-style:italic;font-size:40px;line-height:1.05;\n  letter-spacing:-.5px;margin-bottom:34px}\n.dpv-ab-com{display:flex;align-items:center;justify-content:center;gap:22px;overflow:hidden}\n.dpv-ab-com>div{position:relative;border-radius:24px;overflow:hidden;background:#dfe8ee;\n  box-shadow:0 10px 24px rgba(47,65,86,.08);aspect-ratio:9/16;flex:0 0 auto;width:250px;\n  opacity:.45;transform:scale(.92);transition:opacity .35s ease,transform .35s ease}\n.dpv-ab-com>div[data-active=\"true\"]{width:330px;opacity:1;transform:scale(1)}\n.dpv-ab-play{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);\n  width:44px;height:44px;border-radius:999px;background:rgba(20,24,31,.55);color:#fff;\n  font-size:15px;line-height:1;padding:0;border:0;display:flex;align-items:center;\n  justify-content:center;opacity:0;transition:opacity .2s ease}\n.dpv-ab-com>div:hover .dpv-ab-play,.dpv-ab-play[data-paused=\"true\"]{opacity:1}\n.dpv-ab-com>div[data-active=\"false\"] .dpv-ab-play{display:none}\n@media (max-width:860px){\n  .dpv-ab-com>div .dpv-ab-play,\n  .dpv-ab-com>div[data-active=\"false\"] .dpv-ab-play{display:flex;opacity:1}\n}\n.dpv-ab-arrows{margin-top:18px;display:flex;justify-content:center;gap:10px}\n.dpv-ab-arrows button{width:44px;height:44px;border:1px solid var(--card);\n  background:rgba(255,255,255,.82);border-radius:999px;color:var(--pri);font-size:18px}\n.dpv-ab-arrows button:hover{background:#fff}\n.dpv-ab-don{max-width:760px;margin:48px auto 0}\n.dpv-ab-don b{display:block;font-family:Lora,Georgia,serif;font-style:italic;font-weight:500;\n  font-size:84px;line-height:1;letter-spacing:-1.5px;margin-bottom:8px}\n.dpv-ab-don p{font-size:24px;line-height:1.3;font-weight:600}\n\n@media (max-width:860px){\n  .dpv-ab-hero{grid-template-columns:minmax(0,1fr);gap:32px;padding:48px 20px 32px}\n  h1{font-size:32px;margin-bottom:24px}\n  h2{font-size:25px}\n  .dpv-ab-lead{font-size:15.5px}\n  .dpv-ab-shot-frame{height:340px;border-radius:22px}\n  .dpv-ab-badge{left:14px;bottom:14px}\n  .dpv-ab-story{padding:44px 20px}\n  .dpv-ab-card{padding:26px 22px;border-radius:22px}\n  .dpv-ab-card p{font-size:15.5px}\n  .dpv-ab-quote{padding:18px 20px;margin:26px 0}\n  .dpv-ab-quote p{font-size:19px}\n  .dpv-ab-press-sec,.dpv-ab-com-sec{padding-left:20px;padding-right:20px;padding-bottom:56px}\n  .dpv-ab-press{grid-template-columns:minmax(0,1fr);gap:14px}\n  .dpv-ab-hash{font-size:28px;margin-bottom:22px}\n  .dpv-ab-com{overflow-x:auto;gap:14px;justify-content:flex-start;\n    scroll-snap-type:x proximity;scrollbar-width:none}\n  .dpv-ab-com::-webkit-scrollbar{width:0;height:0}\n  .dpv-ab-com>div,.dpv-ab-com>div[data-active=\"true\"]{flex:0 0 68%;width:auto;\n    opacity:1;transform:none;scroll-snap-align:start}\n  .dpv-ab-arrows{display:flex}\n  .dpv-ab-don b{font-size:56px}\n  .dpv-ab-don p{font-size:18px}\n}\n</style>\n\n<div class=\"dpv-ab\">\n\n  <section class=\"dpv-ab-hero\">\n    <div style=\"max-width:740px\">\n      <div class=\"dpv-ab-kick\">Over ons</div>\n      <h1>Huren voor één dag. <em>Simpel geregeld.</em></h1>\n      <p class=\"dpv-ab-lead\">Wat begon als een simpel idee, groeide uit tot Dagpakketverhuur: een plek waar je activiteiten en partymaterialen voor één dag kunt huren, zonder gedoe en zonder onnodige drempels.</p>\n      <div class=\"dpv-ab-cta\">\n        <a class=\"dpv-ab-btn\" href=\"https://dagpakketverhuur.nl/shop/\">Volledig assortiment</a>\n        <a class=\"dpv-ab-ul\" href=\"https://dagpakketverhuur.nl/contact/\">Naar klantenservice</a>\n      </div>\n    </div>\n    <div class=\"dpv-ab-shot\">\n      <div class=\"dpv-ab-shot-frame\"><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2025/03/IMG_1962-1-scaled.jpg\" alt=\"Joris van Dagpakketverhuur in het magazijn tussen de verhuurmaterialen\" fetchpriority=\"high\"></div>\n      <div class=\"dpv-ab-badge\"><b>25+</b><span>tevreden klanten</span></div>\n    </div>\n  </section>\n\n  <section class=\"dpv-ab-story\">\n    <div class=\"dpv-ab-wrap\" style=\"padding:0\">\n      <div class=\"dpv-ab-card\">\n        <div class=\"dpv-ab-kick\">Ons verhaal</div>\n        <h2>Waarom Dagpakketverhuur bestaat</h2>\n        <div class=\"dpv-ab-paras\">\n          <p>Toen ik 15 jaar oud was en net mijn eindexamens had gedaan, had ik tijd over en wilde ik graag gaan ondernemen. Tijdens het luisteren naar een ondernemerspodcast ontstond het idee: wat als je een compleet pakket voor één dag kunt huren, vol activiteiten, op elke locatie?</p>\n          <p>Ik ging het uitzoeken en had direct meerdere activiteiten op het oog. Alleen: als ik meteen in vijf verschillende activiteiten zou investeren, was ik op mijn 15e al zo'n €2.500 kwijt. Mijn vader zei toen iets heel simpels maar belangrijks: begin eerst met één product en breid van daaruit verder uit.</p>\n          <p>Zo begon ik op mijn 16e met mijn eerste product: 12 laserguns. In april ging Dagpakketverhuur live en in juni kwam de eerste boeking binnen. Vanaf dat moment wist ik dat hier echt vraag naar was.</p>\n          <p>In november 2024 won ik de Student Business Award Drenthe: een prijs voor jonge studenten die ondernemen. Daarbij ontving ik een cheque van €7.500 én een waardevol netwerk. Vanuit daar ben ik verder gaan bouwen. Sinds maart 2026 verhuren we naast activiteiten ook partymaterialen, zodat klanten nog meer op één plek kunnen regelen.</p>\n        </div>\n        <div class=\"dpv-ab-quote\"><p>“Doe wat je leuk vindt en ga je dromen achterna.”</p></div>\n        <div class=\"dpv-ab-award\"><i>★</i><span>Winnaar Student Business Award 2024</span></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"dpv-ab-press-sec\">\n    <h2 style=\"margin-bottom:28px\">Ook wel bekend van</h2>\n    <div class=\"dpv-ab-press\">\n      <div><div class=\"dpv-ab-press-slot\" data-groot><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/dagblad-van-het-noorden.png\" alt=\"Logo Dagblad van het Noorden\" loading=\"lazy\"></div></div>\n      <div><div class=\"dpv-ab-press-slot\" data-groot><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/unnamed.png\" alt=\"Logo Nieuwe Ooststellingwerver\" loading=\"lazy\"></div></div>\n      <div><div class=\"dpv-ab-press-slot\"><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/sba_logo-1.png\" alt=\"Logo Student Business Award\" loading=\"lazy\"></div></div>\n    </div>\n  </section>\n\n  <section class=\"dpv-ab-com-sec\">\n    <h2 style=\"margin-bottom:10px\">Onze community</h2>\n    <div class=\"dpv-ab-hash\">#Dagpakketverhuur</div>\n    <div class=\"dpv-ab-com\" data-dpv-com-grid>\n      <div><video data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/SnapInsta.to_AQO_hgfww_cZer_4jwNFjYtKVghi9lOZuQsheGFKj2g-LOTuHU3MID1pNKj5dMBXI4mnb49uyedxq9YCNCHVW_-x_3Y_Lu08J5quOV0.mp4\" muted loop playsinline preload=\"metadata\" aria-label=\"Sfeervideo van een event van Dagpakketverhuur\"></video><button class=\"dpv-ab-play\" type=\"button\" data-dpv-play aria-label=\"Video pauzeren\">❚❚</button></div>\n      <div><video data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/SnapInsta.to_AQMYVpXY7URFfTUow_w3SQE9r5M8xH6vveLQY9mVfQWgkRzifE6nmNYNplWg6uOHIHm-LWdAKFJ-SdO7mExnxicgc-ewYxWfRRe9N8w.mp4\" muted loop playsinline preload=\"metadata\" aria-label=\"Sfeervideo van een event van Dagpakketverhuur\"></video><button class=\"dpv-ab-play\" type=\"button\" data-dpv-play aria-label=\"Video pauzeren\">❚❚</button></div>\n      <div><video data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2026/03/SnapInsta.to_AQNi1W0vOcLP5qeJlkTI2cq2j7eA8LDUxiyO6cqni6bBe_a6wjPeLI7htk_-uNYNl3ejRoAtap4vYuhJTDv4KdS9CbUMUKhUzkXwLDY.mp4\" muted loop playsinline preload=\"metadata\" aria-label=\"Sfeervideo van een event van Dagpakketverhuur\"></video><button class=\"dpv-ab-play\" type=\"button\" data-dpv-play aria-label=\"Video pauzeren\">❚❚</button></div>\n      <div><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2025/12/Social-media-Kit-Dagpakketverhuur-4.png\" alt=\"Kinderen spelen met Gelblasters op een kinderfeestje\" loading=\"lazy\"></div>\n      <div><img data-skip-lazy class=\"skip-lazy no-lazyload dpv-ab-img\"  src=\"https://dagpakketverhuur.nl/wp-content/uploads/2025/09/F4E27435-5E6B-4CE1-A3FA-FB4B5AE65C54.jpeg\" alt=\"Collega's in actie tijdens een lasergame op een bedrijfsuitje\" loading=\"lazy\"></div>\n    </div>\n    <div class=\"dpv-ab-arrows\">\n      <button type=\"button\" data-dpv-com=\"prev\" aria-label=\"Vorige\">‹</button>\n      <button type=\"button\" data-dpv-com=\"next\" aria-label=\"Volgende\">›</button>\n    </div>\n\n    <div class=\"dpv-ab-don\">\n      <b data-dpv-count=\"50\">€0</b>\n      <p>In totaal gedoneerd aan <span style=\"color:#178fdb\">Stichting Jarige Job</span> en de <span style=\"color:#e77f18\">Voedselbank</span></p>\n    </div>\n  </section>\n\n</div>\n</template>\n\n<script>\n(function(){\n  var host=document.getElementById('dpv-ab-host'),\n      tpl=document.getElementById('dpv-ab-tpl');\n  if(!host||!tpl||host.dataset.dpvInit)return; host.dataset.dpvInit='1';\n\n  var root=host.attachShadow?host.attachShadow({mode:'open'}):host;\n  root.appendChild(tpl.content.cloneNode(true));\n  tpl.remove();\n\n  /* Lazy-load-plugins (LiteSpeed, WP Rocket, Perfmatters) vervangen src door\n     data-src en hun JS komt niet in een shadow root. Daarom zetten we de\n     bronnen hier zelf terug. */\n  root.querySelectorAll('img,video,source').forEach(function(el){\n    var d=el.dataset||{};\n    var src=d.src||d.lazySrc||d.original||d.lazyOriginal||el.getAttribute('data-lazy-src');\n    if(src&&(!el.getAttribute('src')||/^data:image/.test(el.getAttribute('src'))))el.setAttribute('src',src);\n    var ss=d.srcset||d.lazySrcset||el.getAttribute('data-lazy-srcset');\n    if(ss&&!el.getAttribute('srcset'))el.setAttribute('srcset',ss);\n    el.removeAttribute('loading');\n    var ps=d.poster||el.getAttribute('data-lazy-poster');\n    if(ps&&!el.getAttribute('poster'))el.setAttribute('poster',ps);\n    if(el.tagName==='VIDEO'){\n      /* iOS speelt alleen inline en gedempt; zonder metadata blijft het vlak leeg. */\n      el.muted=true; el.defaultMuted=true; el.setAttribute('muted','');\n      el.setAttribute('playsinline',''); el.setAttribute('webkit-playsinline','');\n      if(el.getAttribute('preload')==='none')el.setAttribute('preload','metadata');\n    }\n  });\n\n  /* Vangnet: laadt een plaatje niet, dan één keer opnieuw proberen. */\n  root.querySelectorAll('img').forEach(function(img){\n    img.addEventListener('error',function(){\n      if(img.dataset.dpvRetry)return; img.dataset.dpvRetry='1';\n      var s=img.getAttribute('src')||'';\n      if(s)img.setAttribute('src',s+(s.indexOf('?')>-1?'&':'?')+'dpv=1');\n    });\n  });\n\n\n\n  /* Community-carrousel: drie in beeld, alleen de middelste is actief.\n     Video's laden pas als je op play tikt — dat houdt de pagina snel. */\n  var box=root.querySelector('[data-dpv-com-grid]');\n  if(box){\n    var all=[].slice.call(box.children),i=1;\n    var paint=function(){\n      var mob=window.innerWidth<=860;\n      var order=[(i+all.length-1)%all.length,i,(i+1)%all.length];\n      all.forEach(function(el,n){\n        var pos=order.indexOf(n);\n        el.style.display=(mob||pos>-1)?'':'none';\n        el.dataset.active=(!mob&&pos===1)?'true':'false';\n        var v=el.querySelector('video');\n        if(v){\n          var btn=el.querySelector('[data-dpv-play]');\n          if(!mob&&pos===1){\n            /* midden: laden en spelen */\n            if(v.getAttribute('preload')!=='auto'){v.setAttribute('preload','auto');v.load();}\n            var p=v.play();\n            if(p&&p.catch)p.catch(function(){});\n            if(btn){btn.textContent='❚❚';btn.dataset.paused='false';btn.setAttribute('aria-label','Video pauzeren');}\n          }else{\n            /* zijkant: alleen het eerste frame, niets meer downloaden */\n            v.pause();\n            if(btn){btn.textContent='▶';btn.dataset.paused='true';btn.setAttribute('aria-label','Video afspelen');}\n          }\n        }\n      });\n      if(!mob)order.forEach(function(n){box.appendChild(all[n]);});\n    };\n\n    /* Mobiel: geen carrousel maar een swipe-rij. Video's halen hun eerste frame\n       op zodra ze in beeld komen, zodat er geen leeg vlak staat. */\n    if(window.IntersectionObserver){\n      var io=new IntersectionObserver(function(entries){\n        entries.forEach(function(en){\n          if(!en.isIntersecting)return;\n          var v=en.target.querySelector('video');\n          if(v&&v.getAttribute('preload')!=='auto'&&!v.dataset.dpvSeen){\n            v.dataset.dpvSeen='1';\n            v.setAttribute('preload','metadata');\n            try{v.load();}catch(e){}\n          }\n        });\n      },{rootMargin:'200px'});\n      all.forEach(function(el){io.observe(el);});\n    }\n    root.querySelectorAll('[data-dpv-com]').forEach(function(b){\n      b.addEventListener('click',function(){\n        i=b.dataset.dpvCom==='next'?(i+1)%all.length:(i+all.length-1)%all.length;\n        paint();\n      });\n    });\n    root.querySelectorAll('[data-dpv-play]').forEach(function(btn){\n      btn.addEventListener('click',function(){\n        var v=btn.parentNode.querySelector('video');\n        if(!v)return;\n        if(v.paused){\n          if(v.getAttribute('preload')!=='auto'){v.setAttribute('preload','auto');v.load();}\n          var p=v.play(); if(p&&p.catch)p.catch(function(){});\n          btn.textContent='❚❚'; btn.dataset.paused='false'; btn.setAttribute('aria-label','Video pauzeren');\n        }else{\n          v.pause();\n          btn.textContent='▶'; btn.dataset.paused='true'; btn.setAttribute('aria-label','Video afspelen');\n        }\n      });\n    });\n    window.addEventListener('resize',paint);\n    paint();\n  }\n\n  /* Donatieteller: telt één keer op van 0 naar het eindbedrag */\n  var teller=root.querySelector('[data-dpv-count]');\n  if(teller&&'IntersectionObserver' in window){\n    var doel=parseInt(teller.dataset.dpvCount,10)||0,gedaan=false;\n    var io2=new IntersectionObserver(function(es){\n      es.forEach(function(e){\n        if(!e.isIntersecting||gedaan)return;\n        gedaan=true; io2.disconnect();\n        var t0=null,duur=1400;\n        var stap=function(t){\n          if(t0===null)t0=t;\n          var p=Math.min((t-t0)/duur,1);\n          teller.textContent='€'+Math.round(doel*(1-Math.pow(1-p,3)));\n          if(p<1)requestAnimationFrame(stap);\n        };\n        requestAnimationFrame(stap);\n      });\n    },{threshold:.6});\n    io2.observe(teller);\n  }\n})();\n</script>\n",
