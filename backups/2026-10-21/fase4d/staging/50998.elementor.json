     "html": "<style>\n.elementor-widget-html > .elementor-widget-container { padding: 0 !important; margin: 0 !important; max-width: none !important; }\n.elementor-element:has(.elementor-widget-html > .elementor-widget-container > .kf-page) { max-width: none !important; width: 100vw !important; margin-left: calc(50% - 50vw) !important; margin-right: calc(50% - 50vw) !important; padding-left: 0 !important; padding-right: 0 !important; }\n.elementor-element:has(.kf-page) > .elementor-widget-wrap, .elementor-element:has(.kf-page) > .elementor-container, .elementor-element:has(.kf-page) > .e-con-inner { max-width: none !important; width: 100% !important; }\n\n.kf-page { --navy: #2f4156; --text: #1a1a1a; --muted: #6b6b6b; --white: #ffffff; --off: #f7f7f5; --border: #e8e8e4; --gold: #f5a623; --sans: -apple-system, BlinkMacSystemFont, \"DM Sans\", \"Segoe UI\", sans-serif; --ease: cubic-bezier(.4,0,.2,1); font-family: var(--sans) !important; font-size: 15px !important; line-height: 1.6 !important; color: var(--text) !important; background: var(--white) !important; -webkit-font-smoothing: antialiased !important; width: 100% !important; display: block !important; position: relative !important; overflow-x: hidden !important; }\n.kf-page *, .kf-page *::before, .kf-page *::after { box-sizing: border-box !important; margin: 0 !important; padding: 0 !important; line-height: inherit !important; }\n.kf-page a { text-decoration: none !important; color: inherit !important; }\n.kf-page img { display: block !important; max-width: 100% !important; }\n.kf-page button { font-family: var(--sans) !important; }\n\n.kf-page .sr { opacity: 0 !important; transform: translateY(24px) !important; transition: opacity 0.6s var(--ease), transform 0.6s var(--ease) !important; }\n.kf-page .sr.sr-left { transform: translateX(-24px) !important; }\n.kf-page .sr.sr-right { transform: translateX(24px) !important; }\n.kf-page .sr.in { opacity: 1 !important; transform: none !important; }\n.kf-page .sr-d1 { t