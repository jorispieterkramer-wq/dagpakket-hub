r-color 0.18s, transform 0.18s !important; }\n.kf-page .kf-regio-pill:hover { background: #eef2f6 !important; border-color: var(--navy) !important; transform: translateY(-1px) !important; }\n\n.kf-page .kf-faq-sec { padding: 68px 0 !important; }\n.kf-page .kf-faq-inner { display: grid !important; grid-template-columns: 260px 1fr !important; gap: 72px !important; align-items: start !important; }\n.kf-page .kf-faq-left h2 { font-size: clamp(20px, 2.2vw, 28px) !important; font-weight: 800 !important; letter-spacing: -0.03em !important; margin-bottom: 10px !important; }\n.kf-page .kf-faq-left p { font-size: 13px !important; color: var(--muted) !important; line-height: 1.65 !important; margin-bottom: 20px !important; }\n.kf-page .kf-faq-wa { display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 11px 18px !important; background: #25d366 !important; color: #fff !important; border-radius: 10px !important; font-size: 13px !important; font-weight: 700 !important; transition: background 0.2s !important; }\n.kf-page .kf-faq-wa:hover { background: #1dba57 !important; }\n.kf-page .kf-faq-item { border-bottom: 1px solid var(--border) !important; }\n.kf-page .kf-faq-q { width: 100% !important; text-align: left !important; padding: 16px 0 !important; font-size: 14px !important; font-weight: 600 !important; color: var(--text) !important; background: none !important; border: none !important; cursor: pointer !important; display: flex !important; justify-content: space-between !important; align-items: center !important; gap: 16px !important; transition: color 0.2s !important; }\n.kf-page .kf-faq-q:hover { color: var(--navy) !important; }\n.kf-page .kf-faq-icon { width: 22px !important; height: 22px !important; border-radius: 50% !important; background: var(--off) !important; border: 1px solid var(--border) !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; font-size: 14px !important; transition: background 0.22s, transform 0.3s var(--ease), border-color 0.22s !important; color: var(--navy) !important; }\n.kf-page .kf-faq-item.open .kf-faq-icon { background: var(--navy) !important; color: #fff !important; border-color: var(--navy) !important; transform: rotate(45deg) !important; }\n.kf-page .kf-faq-a { overflow: hidden !important; max-height: 0 !important; transition: max-height 0.4s var(--ease), padding 0.3s !important; font-size: 13px !important; color: #555 !important; line-height: 1.7 !important; padding: 0 32px 0 0 !important; }\n.kf-page .kf-faq-item.open .kf-faq-a { max-height: 300px !important; padding-bottom: 16px !important; }\n\n@media (max-width: 960px) {\n  .kf-page .kf-intro-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-joris { position: static !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: repeat(2, 1fr) !important; }\n  .kf-page .kf-review-inner { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-page .kf-regio-blok { grid-template-columns: 1fr !important; gap: 20px !important; }\n  .kf-page .kf-faq-inner { grid-template-columns: 1fr !important; gap: 28px !important; }\n}\n@media (max-width: 600px) {\n  .kf-page .kf-w { padding: 0 20px !important; }\n  .kf-page .kf-hero-content { padding: 0 20px 40px !important; }\n  .kf-page .kf-gel-grid { grid-template-columns: 1fr !important; }\n}\n</style>\n\n<div class=\"kf-page\">\n<section class=\"kf-hero\">\n  <div class=\"kf-hero-img\" id=\"%%PARALLAX_ID%%\"></div>\n  <div class=\"kf-hero-content\">\n    <span class=\"kf-hero-tag\">Stretchtent huren · Friesland</span>\n    <h1>Stretchtent huren<br><em>in Friesland.</em></h1>\n    <div class=\"kf-hero-meta\">\n      <a href=\"/product-category/tenten-verwarming-huren/stretchtenten-huren/\" class=\"kf-hero-cta\">Bekijk stretchtenten &#x2192;</a>\n      <span class=\"kf-hero-pill\">&#x2713; Bezorgd in Friesland</span><span class=\"kf-hero-pill\">&#x2713; Geen borg</span><span class=\"kf-hero-pill\">&#x2713; Gratis v.a. &#x20AC;150</span>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-intro\">\n  <div class=\"kf-w\">\n    <div class=\"kf-intro-inner\">\n      <div class=\"kf-intro-left\">\n        <span class=\"kf-eyebrow sr\">Stretchtent huren in Friesland</span>\n        <h2 class=\"sr sr-d1\">Stretchtent huren in Friesland — stijlvol en kant-en-klaar</h2>\n        <p class=\"sr sr-d2\">Stretchtent huren in Friesland doe je bij DagpakketVerhuur. Met zijn organische vorm en gespannen doek op houten palen geeft een stretchtent elk buiten evenement een unieke, elegante uitstraling. Kant-en-klaar bezorgd aan huis in Friesland en de omliggende plaatsen.</p><p class=\"sr sr-d3\">Geen borg, geen gedoe. De stretchtent is waterproof en bestand tegen regen en wind — perfect voor evenementen in het voorjaar, zomer en najaar. Combineer met een terrasverwarmer voor een complete winteropstelling. Na afloop halen wij alles weer op. Gratis bezorging in Friesland vanaf €150 besteding.</p><p class=\"sr sr-d4\">Wil je de stretchtent combineren met statafels, verlichting of funfood? Bestel alles tegelijk via de webshop en wij bezorgen het in één keer.</p>\n      </div>\n      <div class=\"kf-joris sr sr-right sr-d2\">\n        <div class=\"kf-joris-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2025/03/IMG_1962-1-scaled.jpg\" alt=\"Joris van DagpakketVerhuur\" loading=\"lazy\">\n        </div>\n        <div class=\"kf-joris-body\">\n          <p class=\"kf-joris-quote\">Een stretchtent is een klasse apart — de vorm en sfeer die het geeft aan een tuin of feestlocatie is echt bijzonder. Ik lever ze persoonlijk in Friesland.</p>\n          <div class=\"kf-joris-name\">\n            <div class=\"kf-joris-avatar\">J</div>\n            <div class=\"kf-joris-info\"><strong>Joris</strong><span>Oprichter DagpakketVerhuur</span></div>\n          </div>\n          <a href=\"https://wa.me/31852129150\" class=\"kf-joris-wa\">&#x1F4AC; WhatsApp Joris direct</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-gel-sec\">\n  <div class=\"kf-w\">\n    <span class=\"kf-eyebrow sr\">Perfect voor</span>\n    <h2 class=\"sr sr-d1\">Stretchtent huren in Friesland — voor elk evenement</h2>\n    <p class=\"sr sr-d2\">Een stretchtent geeft elk buiten evenement een stijlvolle en sfeervolle overdekking.</p>\n    <div class=\"kf-gel-grid\">\n      <a href=\"/kinderfeestje/\" class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F382;</span>\n        <strong>Kinderfeestje buiten</strong>\n        <span>Zorg dat de kids droog blijven en toch buiten kunnen feesten in Friesland. Combineer met lasergame of springkussen.</span>\n      </a>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F492;</span>\n        <strong>Bruiloft &amp; receptie</strong>\n        <span>Een stretchtent geeft jullie grote dag een unieke, elegante sfeer. Stijlvoller dan een gewone partytent.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F4BC;</span>\n        <strong>Kerstborrel &amp; bedrijfsfeest</strong>\n        <span>Buiten vieren in de winter? Een stretchtent met terrasverwarmer maakt elk bedrijfsfeest in Friesland mogelijk.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d1\">\n        <span class=\"kf-gel-icon\">&#x1F38A;</span>\n        <strong>Verjaardag &amp; tuinfeest</strong>\n        <span>Ongeacht het weer — een stretchtent zorgt dat jouw feest in Friesland doorgaat.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d2\">\n        <span class=\"kf-gel-icon\">&#x1F3D8;&#xFE0F;</span>\n        <strong>Buurtfeest</strong>\n        <span>Een stretchtent op straat of in het park maakt van een buurtfeest in Friesland een echt evenement.</span>\n      </div>\n      <div class=\"kf-gel-card sr sr-d3\">\n        <span class=\"kf-gel-icon\">&#x1F3EB;</span>\n        <strong>Schoolevenement &amp; sportdag</strong>\n        <span>Stijlvolle overdekking voor sportevenementen, schoolfeesten en verenigingsactiviteiten.</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-review\">\n  <div class=\"kf-w\">\n    <div class=\"kf-review-inner\">\n      <div class=\"kf-review-text sr sr-left\">\n        <div class=\"kf-stars\">&#x2605;&#x2605;&#x2605;&#x2605;&#x2605;</div>\n        <p class=\"kf-review-quote\">&#x201C;De stretchtent gaf onze bruiloft precies de sfeer die we zochten. Stijlvol, sfeervol en perfect opgebouwd. Bezorgd in Friesland, alles klopte tot in de puntjes.&#x201D;</p>\n        <div class=\"kf-review-author\">\n          <div class=\"kf-review-avatar\">S</div>\n          <div><strong>Sandra B.</strong><span>Geverifieerde huurder · Friesland</span></div>\n        </div>\n        <a href=\"https://g.page/r/dagpakketverhuur/review\" class=\"kf-more-reviews\">Bekijk alle 25+ reviews &#x2192;</a>\n      </div>\n      <div class=\"kf-review-photo sr sr-right sr-d1\">\n        <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/08/Gemini_Generated_Image_sbd730sbd730sbd7_11zon.webp\" alt=\"Stretchtent huren Friesland - DagpakketVerhuur\" loading=\"lazy\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-regio-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-regio-blok sr\">\n      <div class=\"kf-regio-blok-left\">\n        <span class=\"kf-eyebrow\">Stretchtent per regio</span>\n        <h2>Stretchtent huren in een andere regio?</h2>\n        <p>Wij bezorgen door heel Noord-Nederland. Kies jouw regio:</p>\n      </div>\n      <div>\n        <div class=\"kf-regio-pills\"><a href=\"/stretchtent-huren/\" class=\"kf-regio-pill\">🇳🇱 Noord-Nederland</a><a href=\"/stretchtent-huren-drenthe/\" class=\"kf-regio-pill\">📍 Drenthe</a><a href=\"/stretchtent-huren-groningen/\" class=\"kf-regio-pill\">📍 Groningen</a><a href=\"/partytent-huren-friesland/\" class=\"kf-regio-pill\">⛺ Partytent Friesland</a><a href=\"/kinderfeestje-friesland/\" class=\"kf-regio-pill\">🎂 Kinderfeestje Friesland</a></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"kf-faq-sec\">\n  <div class=\"kf-w\">\n    <div class=\"kf-faq-inner\">\n      <div class=\"kf-faq-left sr sr-left\">\n        <span class=\"kf-eyebrow\">Vragen?</span>\n        <h2>Veelgestelde vragen</h2>\n        <p>Staat jouw vraag er niet bij? App Joris direct.</p>\n        <a href=\"https://wa.me/31852129150\" class=\"kf-faq-wa\">&#x1F4AC; WhatsApp Joris</a>\n      </div>\n      <div class=\"kf-faq-list sr sr-d1\"><div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Bezorgen jullie een stretchtent gratis in Friesland?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Ja, wij bezorgen gratis in Friesland en omgeving bij een besteding vanaf €150. Woon je net buiten Friesland? Geen probleem — wij bezorgen door heel Friesland. Check de transportpagina voor het exacte tarief op basis van jouw postcode.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Wat is het verschil tussen een stretchtent en een partytent?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Een stretchtent heeft een organische, elegante vorm door het gespannen doek op houten palen. Dit geeft een veel stijlvoller en sfeervoller effect dan een traditionele partytent. Ideaal voor bruiloften, recepties en chique tuinfeesten.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">In welke maten zijn de stretchtenten beschikbaar?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Wij verhuren stretchtenten in verschillende maten, van klein voor een intiem feestje tot groot voor tientallen gasten. Twijfel je welke maat past bij jouw evenement in Friesland? Stuur een WhatsApp en Joris denkt mee.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Kunnen stretchtenten ook bij slecht weer worden gebruikt?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Ja, stretchtenten zijn waterproof en bestand tegen regen en wind. Combineer met een terrasverwarmer voor de perfecte sfeer bij een buiten evenement in het najaar of winter.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Is er een borgsom bij stretchtent huren?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Nee, wij vragen geen borg. Je betaalt alleen de huurprijs — geen verborgen kosten. Na gebruik halen wij alles weer op in Friesland en omgeving.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Kan ik een stretchtent combineren met andere huurartikelen?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">Zeker. Stretchtenten combineren perfect met statafels, terrasverwarmer, verlichting of funfood. Bestel alles tegelijk via de webshop — wij bezorgen het in één keer in Friesland.</div></div>\n<div class=\"kf-faq-item\"><button class=\"kf-faq-q\">Hoe ver van tevoren moet ik reserveren?<span class=\"kf-faq-icon\">+</span></button><div class=\"kf-faq-a\">We adviseren minimaal 5 tot 7 dagen van tevoren te reserveren voor een stretchtent, zeker in drukke periodes. Check beschikbaarheid in de webshop of stuur een WhatsApp.</div></div>\n</div>\n    </div>\n  </div>\n</section>\n</div>\n\n<script>\n(function(){\n  var io=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add(\"in\");io.unobserve(e.target);}});},{threshold:0.1});\n  document.querySelectorAll(\".kf-page .sr\").forEach(function(el){io.observe(el);});\n  var p=document.getElementById(\"%%PARALLAX_ID%%\");\n  if(p)window.addEventListener(\"scroll\",function(){p.style.transform=\"scale(1.08) translateY(\"+(window.scrollY*.24)+\"px)\";},{passive:true});\n  document.querySelectorAll(\".kf-page .kf-faq-q\").forEach(function(btn){\n    btn.addEventListener(\"click\",function(){\n      var item=this.closest(\".kf-faq-item\"),open=item.classList.contains(\"open\");\n      document.querySelectorAll(\".kf-page .kf-faq-item\").forEach(function(i){i.classList.remove(\"open\");});\n      if(!open)item.classList.add(\"open\");\n    });\n  });\n})();\n</script>",
