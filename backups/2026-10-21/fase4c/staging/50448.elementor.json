    "settings": {
     "html": "<style>\n/* ── ELEMENTOR RESET ── */\n.elementor-widget-html > .elementor-widget-container {\n  padding: 0 !important;\n  margin: 0 !important;\n  max-width: none !important;\n}\n\n.elementor-element:has(.elementor-widget-html > .elementor-widget-container > .kf-regio) {\n  max-width: none !important;\n  width: 100vw !important;\n  margin-left: calc(50% - 50vw) !important;\n  margin-right: calc(50% - 50vw) !important;\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n/* ── SCOPED VARS ── */\n.kf-regio {\n  --navy: #2f4156;\n  --text: #1a1a1a;\n  --muted: #6b6b6b;\n  --white: #ffffff;\n  --off: #f7f7f5;\n  --border: #e8e8e4;\n  --gold: #f5a623;\n  --sans: -apple-system, BlinkMacSystemFont, 'DM Sans', 'Segoe UI', sans-serif;\n  --ease: cubic-bezier(.4,0,.2,1);\n\n  font-family: var(--sans) !important;\n  color: var(--text) !important;\n  background: var(--white) !important;\n  -webkit-font-smoothing: antialiased !important;\n  width: 100% !important;\n  display: block !important;\n  overflow-x: hidden !important;\n}\n\n.kf-regio *, .kf-regio *::before, .kf-regio *::after {\n  box-sizing: border-box !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.kf-regio a { text-decoration: none !important; color: inherit !important; }\n.kf-regio img { display: block !important; max-width: 100% !important; }\n\n/* ── SCROLL REVEAL ── */\n.kf-regio .sr {\n  opacity: 0 !important;\n  transform: translateY(24px) !important;\n  transition: opacity 0.6s var(--ease), transform 0.6s var(--ease) !important;\n}\n.kf-regio .sr.in { opacity: 1 !important; transform: none !important; }\n.kf-regio .sr-d1 { transition-delay: 0.08s !important; }\n.kf-regio .sr-d2 { transition-delay: 0.16s !important; }\n.kf-regio .sr-d3 { transition-delay: 0.24s !important; }\n\n/* ── HERO ── */\n.kf-regio .kr-hero {\n  position: relative !important;\n  height: 55vh !important;\n  min-height: 380px !important;\n  max-height: 560px !important;\n  overflow: hidden !important;\n  display: flex !important;\n  align-items: flex-end !important;\n}\n\n.kf-regio .kr-hero-img {\n  position: absolute !important;\n  inset: 0 !important;\n  background:\n    linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.65) 100%),\n    url('https://staging.dagpakketverhuur.nl/wp-content/uploads/2025/12/Social-media-Kit-Dagpakketverhuur-4.png') center/cover no-repeat !important;\n}\n\n.kf-regio .kr-hero-content {\n  position: relative !important;\n  z-index: 2 !important;\n  width: 100% !important;\n  max-width: 1160px !important;\n  margin: 0 auto !important;\n  padding: 0 32px 48px !important;\n}\n\n.kf-regio .kr-hero-tag {\n  display: inline-block !important;\n  font-size: 11px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.14em !important;\n  text-transform: uppercase !important;\n  color: rgba(255,255,255,0.55) !important;\n  margin-bottom: 12px !important;\n}\n\n.kf-regio .kr-hero h1 {\n  font-size: clamp(28px, 4.5vw, 56px) !important;\n  font-weight: 800 !important;\n  color: #fff !important;\n  line-height: 1.05 !important;\n  letter-spacing: -0.03em !important;\n  margin-bottom: 18px !important;\n  max-width: 680px !important;\n}\n\n.kf-regio .kr-hero h1 em {\n  font-style: italic !important;\n  font-weight: 400 !important;\n  color: rgba(255,255,255,0.75) !important;\n}\n\n.kf-regio .kr-hero-meta {\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n  flex-wrap: wrap !important;\n}\n\n.kf-regio .kr-hero-pill {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 8px 14px !important;\n  border-radius: 999px !important;\n  background: rgba(255,255,255,0.12) !important;\n  border: 1px solid rgba(255,255,255,0.18) !important;\n  color: rgba(255,255,255,0.9) !important;\n  font-size: 12px !important;\n  font-weight: 600 !important;\n}\n\n.kf-regio .kr-hero-cta {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n  padding: 12px 24px !important;\n  background: #fff !important;\n  color: var(--navy) !important;\n  border-radius: 10px !important;\n  font-size: 13px !important;\n  font-weight: 700 !important;\n  transition: background 0.2s !important;\n}\n.kf-regio .kr-hero-cta:hover { background: #f0f0ee !important; }\n\n/* ── LAYOUT ── */\n.kf-regio .kr-w {\n  max-width: 1160px !important;\n  margin: 0 auto !important;\n  padding: 0 32px !important;\n}\n\n.kf-regio .kr-sec {\n  padding: 64px 0 !important;\n  border-bottom: 1px solid var(--border) !important;\n}\n\n.kf-regio .kr-eyebrow {\n  font-size: 11px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.13em !important;\n  text-transform: uppercase !important;\n  color: var(--navy) !important;\n  display: block !important;\n  margin-bottom: 10px !important;\n}\n\n.kf-regio .kr-h2 {\n  font-size: clamp(22px, 3vw, 34px) !important;\n  font-weight: 800 !important;\n  letter-spacing: -0.03em !important;\n  margin-bottom: 12px !important;\n  color: var(--text) !important;\n  line-height: 1.1 !important;\n}\n\n.kf-regio .kr-lead {\n  font-size: 15px !important;\n  color: #444 !important;\n  line-height: 1.75 !important;\n  max-width: 600px !important;\n  margin-bottom: 32px !important;\n}\n\n/* ── INTRO GRID ── */\n.kf-regio .kr-intro-grid {\n  display: grid !important;\n  grid-template-columns: 1fr 1fr !important;\n  gap: 64px !important;\n  align-items: center !important;\n}\n\n.kf-regio .kr-intro-text p {\n  font-size: 15px !important;\n  color: #444 !important;\n  line-height: 1.75 !important;\n  margin-bottom: 16px !important;\n}\n\n.kf-regio .kr-intro-usps {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 12px !important;\n  margin-top: 24px !important;\n}\n\n.kf-regio .kr-usp {\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n  font-size: 14px !important;\n  font-weight: 600 !important;\n  color: var(--text) !important;\n}\n\n.kf-regio .kr-usp-icon {\n  width: 36px !important;\n  height: 36px !important;\n  border-radius: 50% !important;\n  background: var(--navy) !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  color: #fff !important;\n  font-size: 15px !important;\n  flex-shrink: 0 !important;\n}\n\n.kf-regio .kr-intro-img {\n  border-radius: 16px !important;\n  overflow: hidden !important;\n  aspect-ratio: 4/3 !important;\n  background: #ddd !important;\n}\n.kf-regio .kr-intro-img img {\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n}\n\n/* ── CATEGORIEEN ── */\n.kf-regio .kr-cats-grid {\n  display: grid !important;\n  grid-template-columns: repeat(4, 1fr) !important;\n  gap: 12px !important;\n}\n\n.kf-regio .kr-cat {\n  display: block !important;\n  position: relative !important;\n  border-radius: 14px !important;\n  overflow: hidden !important;\n  aspect-ratio: 1/1 !important;\n  transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease) !important;\n}\n.kf-regio .kr-cat:hover {\n  transform: translateY(-4px) !important;\n  box-shadow: 0 12px 32px rgba(0,0,0,0.15) !important;\n}\n\n.kf-regio .kr-cat-img {\n  position: absolute !important;\n  inset: 0 !important;\n  background: #2a3a4a !important;\n  overflow: hidden !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n}\n.kf-regio .kr-cat-img img {\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n  transition: transform 0.5s var(--ease) !important;\n}\n.kf-regio .kr-cat:hover .kr-cat-img img { transform: scale(1.06) !important; }\n\n.kf-regio .kr-cat-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(180deg, rgba(0,0,0,0.04) 20%, rgba(0,0,0,0.68) 100%) !important;\n}\n\n.kf-regio .kr-cat-body {\n  position: absolute !important;\n  bottom: 0 !important;\n  left: 0 !important;\n  right: 0 !important;\n  padding: 16px 18px 20px !important;\n  z-index: 2 !important;\n}\n\n.kf-regio .kr-cat-name {\n  font-size: 16px !important;\n  font-weight: 700 !important;\n  color: #fff !important;\n  line-height: 1.2 !important;\n}\n\n/* ── PLAATSEN ── */\n.kf-regio .kr-plaatsen-grid {\n  display: flex !important;\n  flex-wrap: wrap !important;\n  gap: 10px !important;\n  margin-top: 24px !important;\n}\n\n.kf-regio .kr-plaats {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 8px 14px !important;\n  border: 1.5px solid var(--border) !important;\n  border-radius: 999px !important;\n  font-size: 13px !important;\n  font-weight: 600 !important;\n  color: var(--navy) !important;\n  background: #fff !important;\n  transition: background 0.15s, border-color 0.15s !important;\n}\n.kf-regio .kr-plaats:hover {\n  background: #eef2f6 !important;\n  border-color: var(--navy) !important;\n}\n\n.kf-regio .kr-plaats-km {\n  font-size: 11px !important;\n  color: #999 !important;\n  font-weight: 400 !important;\n}\n\n/* ── BACK LINK ── */\n.kf-regio .kr-back {\n  padding: 48px 0 !important;\n  text-align: center !important;\n}\n\n.kf-regio .kr-back-link {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n  font-size: 14px !important;\n  font-weight: 600 !important;\n  color: var(--navy) !important;\n  border-bottom: 1.5px solid var(--navy) !important;\n  padding-bottom: 2px !important;\n  transition: gap 0.2s !important;\n}\n.kf-regio .kr-back-link:hover { gap: 12px !important; }\n\n/* ── PRODUCT LINKS ── */\n.kf-regio .kr-product-links {\n  display: flex !important;\n  flex-wrap: wrap !important;\n  gap: 10px !important;\n  margin-top: 20px !important;\n}\n\n.kf-regio .kr-product-link {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 10px 18px !important;\n  border: 1.5px solid var(--border) !important;\n  border-radius: 10px !important;\n  font-size: 13px !important;\n  font-weight: 600 !important;\n  color: var(--navy) !important;\n  background: #fff !important;\n  transition: background 0.15s, border-color 0.15s, transform 0.15s !important;\n}\n.kf-regio .kr-product-link:hover {\n  background: #eef2f6 !important;\n  border-color: var(--navy) !important;\n  transform: translateY(-1px) !important;\n}\n\n/* ── FAQ ── */\n.kf-regio .kr-faq {\n  max-width: 720px !important;\n}\n\n.kf-regio .kr-faq-item {\n  border-bottom: 1px solid var(--border) !important;\n}\n\n.kf-regio .kr-faq-q {\n  width: 100% !important;\n  text-align: left !important;\n  padding: 16px 0 !important;\n  font-size: 14px !important;\n  font-weight: 600 !important;\n  color: var(--text) !important;\n  background: none !important;\n  border: none !important;\n  cursor: pointer !important;\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  gap: 16px !important;\n  font-family: var(--sans) !important;\n  transition: color 0.2s !important;\n}\n.kf-regio .kr-faq-q:hover { color: var(--navy) !important; }\n\n.kf-regio .kr-faq-icon {\n  width: 22px !important;\n  height: 22px !important;\n  border-radius: 50% !important;\n  background: var(--off) !important;\n  border: 1px solid var(--border) !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  flex-shrink: 0 !important;\n  font-size: 14px !important;\n  transition: background 0.2s, transform 0.3s var(--ease) !important;\n  color: var(--navy) !important;\n}\n\n.kf-regio .kr-faq-item.open .kr-faq-icon {\n  background: var(--navy) !important;\n  color: #fff !important;\n  border-color: var(--navy) !important;\n  transform: rotate(45deg) !important;\n}\n\n.kf-regio .kr-faq-a {\n  overflow: hidden !important;\n  max-height: 0 !important;\n  transition: max-height 0.4s var(--ease), padding 0.3s !important;\n  font-size: 14px !important;\n  color: #555 !important;\n  line-height: 1.7 !important;\n  padding: 0 !important;\n}\n\n.kf-regio .kr-faq-item.open .kr-faq-a {\n  max-height: 400px !important;\n  padding-bottom: 16px !important;\n}\n\n/* ── RESPONSIVE ── */\n@media (max-width: 960px) {\n  .kf-regio .kr-intro-grid { grid-template-columns: 1fr !important; gap: 36px !important; }\n  .kf-regio .kr-cats-grid { grid-template-columns: repeat(2, 1fr) !important; }\n}\n\n@media (max-width: 600px) {\n  .kf-regio .kr-w { padding: 0 20px !important; }\n  .kf-regio .kr-hero-content { padding: 0 20px 36px !important; }\n  .kf-regio .kr-cats-grid { grid-template-columns: 1fr !important; }\n  .kf-regio .kr-sec { padding: 44px 0 !important; }\n}\n</style>\n\n<div class=\"kf-regio\">\n\n<!-- ── HERO ── -->\n<section class=\"kr-hero\">\n  <div class=\"kr-hero-img\"></div>\n  <div class=\"kr-hero-content\">\n    <span class=\"kr-hero-tag\">Kinderfeestje Groningen</span>\n    <h1>Kinderfeestje in Groningen?<br><em>Wij regelen het.</em></h1>\n    <div class=\"kr-hero-meta\">\n      <a href=\"/product-category/activiteiten-huren/\" class=\"kr-hero-cta\">Bekijk activiteiten</a>\n      <span class=\"kr-hero-pill\">✓ Persoonlijke bezorging</span>\n      <span class=\"kr-hero-pill\">✓ Geen borg</span>\n      <span class=\"kr-hero-pill\">✓ Gratis v.a. €150</span>\n    </div>\n  </div>\n</section>\n\n<!-- ── INTRO ── -->\n<section class=\"kr-sec\">\n  <div class=\"kr-w\">\n    <div class=\"kr-intro-grid\">\n      <div class=\"kr-intro-text sr\">\n        <span class=\"kr-eyebrow\">Kinderfeestje Groningen</span>\n        <h2 class=\"kr-h2\">Compleet kinderfeestje pakket, bezorgd in Groningen</h2>\n        <p>Op zoek naar een leuke activiteit voor een kinderfeestje in Groningen? Bij DagpakketVerhuur huur je lasergame, gelblaster, springkussen en meer — kant-en-klaar bezorgd aan huis.</p>\n        <p>Wij bezorgen persoonlijk door heel Groningen. Van Groningen stad tot Veendam en van Winschoten tot Zuidhorn — wij komen bij jou thuis.</p>\n        <div class=\"kr-intro-usps\">\n          <div class=\"kr-usp\">\n            <div class=\"kr-usp-icon\">✓</div>\n            <span>Persoonlijke bezorging in Groningen</span>\n          </div>\n          <div class=\"kr-usp\">\n            <div class=\"kr-usp-icon\">✓</div>\n            <span>Gratis bezorging vanaf €150</span>\n          </div>\n          <div class=\"kr-usp\">\n            <div class=\"kr-usp-icon\">✓</div>\n            <span>Geen borg vereist</span>\n          </div>\n          <div class=\"kr-usp\">\n            <div class=\"kr-usp-icon\">✓</div>\n            <span>Wij halen alles weer op</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"kr-intro-img sr sr-d1\">\n        <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/02/Ontwerp-zonder-titel-_1__11zon.webp\" alt=\"Kinderfeestje activiteiten huren Friesland\" loading=\"lazy\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ── CATEGORIEEEN ── -->\n<section class=\"kr-sec\" style=\"background: #f8f8f7 !important;\">\n  <div class=\"kr-w\">\n    <span class=\"kr-eyebrow sr\">Ons aanbod</span>\n    <h2 class=\"kr-h2 sr sr-d1\">Wat past bij jouw kinderfeestje?</h2>\n    <div class=\"kr-cats-grid\" style=\"margin-top: 28px !important;\">\n      <a href=\"/product-category/activiteiten-huren/\" class=\"kr-cat sr sr-d1\">\n        <div class=\"kr-cat-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/08/Gemini_Generated_Image_uojpcsuojpcsuojp_11zon.webp\" alt=\"Lasergame huren kinderfeestje Friesland\" loading=\"lazy\">\n        </div>\n        <div class=\"kr-cat-overlay\"></div>\n        <div class=\"kr-cat-body\"><div class=\"kr-cat-name\">Activiteiten</div></div>\n      </a>\n      <a href=\"/product-category/springkussens-huren/\" class=\"kr-cat sr sr-d2\">\n        <div class=\"kr-cat-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/08/Gemini_Generated_Image_xu14z0xu14z0xu14_11zon.webp\" alt=\"Springkussen huren Friesland\" loading=\"lazy\">\n        </div>\n        <div class=\"kr-cat-overlay\"></div>\n        <div class=\"kr-cat-body\"><div class=\"kr-cat-name\">Springkussens</div></div>\n      </a>\n      <a href=\"/product-category/tenten-verwarming-huren/\" class=\"kr-cat sr sr-d3\">\n        <div class=\"kr-cat-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/08/Gemini_Generated_Image_afvuyfafvuyfafvu_11zon.webp\" alt=\"Partytent huren Groningen\" loading=\"lazy\">\n        </div>\n        <div class=\"kr-cat-overlay\"></div>\n        <div class=\"kr-cat-body\"><div class=\"kr-cat-name\">Tenten</div></div>\n      </a>\n      <a href=\"/product-category/funfood-huren/\" class=\"kr-cat sr sr-d3\">\n        <div class=\"kr-cat-img\">\n          <img src=\"https://staging.dagpakketverhuur.nl/wp-content/uploads/2026/08/Gemini_Generated_Image_mguaynmguaynmgua_11zon.webp\" alt=\"Funfood huren kinderfeestje Friesland\" loading=\"lazy\">\n        </div>\n        <div class=\"kr-cat-overlay\"></div>\n        <div class=\"kr-cat-body\"><div class=\"kr-cat-name\">Funfood</div></div>\n      </a>\n    </div>\n  </div>\n</section>\n\n<!-- ── PRODUCT LINKS ── -->\n<section class=\"kr-sec\">\n  <div class=\"kr-w\">\n    <span class=\"kr-eyebrow sr\">Specifiek zoeken?</span>\n    <h2 class=\"kr-h2 sr sr-d1\">Populaire activiteiten in Groningen</h2>\n    <p class=\"kr-lead sr sr-d2\">Zoek je een specifieke activiteit in Groningen? Bekijk onze regiopagina's:</p>\n    <div class=\"kr-product-links sr sr-d2\">\n      <a href=\"/lasergame-huren-groningen/\" class=\"kr-product-link\">🎯 Lasergame huren Groningen</a>\n      <a href=\"/partytent-huren-groningen/\" class=\"kr-product-link\">⛺ Partytent huren Groningen</a>\n      <a href=\"/silent-disco-huren-groningen/\" class=\"kr-product-link\">🎧 Silent disco huren Groningen</a>\n      <a href=\"/statafel-huren-groningen/\" class=\"kr-product-link\">🪑 Statafel huren Groningen</a>\n    </div>\n  </div>\n</section>\n\n<!-- ── PLAATSEN ── -->\n<section class=\"kr-sec\" style=\"background: #f8f8f7 !important;\">\n  <div class=\"kr-w\">\n    <span class=\"kr-eyebrow sr\">Bezorging</span>\n    <h2 class=\"kr-h2 sr sr-d1\">Wij bezorgen door heel Groningen</h2>\n    <p class=\"kr-lead sr sr-d2\">Van Groningen stad tot Veendam en van Winschoten tot Zuidhorn — wij komen bij jou thuis. Gratis bezorging vanaf €150.</p>\n    <div class=\"kr-plaatsen-grid sr sr-d2\">\n      <span class=\"kr-plaats\">📍 Leeuwarden <span class=\"kr-plaats-km\">hoofdstad</span></span>\n      <span class=\"kr-plaats\">📍 Drachten <span class=\"kr-plaats-km\">±30 km</span></span>\n      <span class=\"kr-plaats\">📍 Heerenveen <span class=\"kr-plaats-km\">±35 km</span></span>\n      <span class=\"kr-plaats\">📍 Sneek <span class=\"kr-plaats-km\">±25 km</span></span>\n      <span class=\"kr-plaats\">📍 Franeker <span class=\"kr-plaats-km\">±25 km</span></span>\n      <span class=\"kr-plaats\">📍 Harlingen <span class=\"kr-plaats-km\">±30 km</span></span>\n      <span class=\"kr-plaats\">📍 Joure <span class=\"kr-plaats-km\">±40 km</span></span>\n      <span class=\"kr-plaats\">📍 Dokkum <span class=\"kr-plaats-km\">±40 km</span></span>\n    </div>\n  </div>\n</section>\n\n<!-- ── FAQ ── -->\n<section class=\"kr-sec\">\n  <div class=\"kr-w\">\n    <span class=\"kr-eyebrow sr\">Vragen?</span>\n    <h2 class=\"kr-h2 sr sr-d1\">Veelgestelde vragen over kinderfeestje huren in Groningen</h2>\n    <div class=\"kr-faq sr sr-d2\">\n\n      <div class=\"kr-faq-item\">\n        <button class=\"kr-faq-q\">Bezorgen jullie ook in kleine plaatsen in Groningen?<span class=\"kr-faq-icon\">+</span></button>\n        <div class=\"kr-faq-a\">Ja, wij bezorgen door heel Groningen. Ook in kleinere plaatsen. Neem bij twijfel contact op via WhatsApp, dan kijken we het samen na.</div>\n      </div>\n\n      <div class=\"kr-faq-item\">\n        <button class=\"kr-faq-q\">Wat kost bezorging in Groningen?<span class=\"kr-faq-icon\">+</span></button>\n        <div class=\"kr-faq-a\">Friesland valt in Zone 1 — bezorging kost €40. Gratis bezorging vanaf €150 besteding. Ophalen is altijd gratis.</div>\n      </div>\n\n      <div class=\"kr-faq-item\">\n        <button class=\"kr-faq-q\">Welke activiteiten zijn het populairst voor een kinderfeestje in Groningen?<span class=\"kr-faq-icon\">+</span></button>\n        <div class=\"kr-faq-a\">Lasergame en gelblaster zijn veruit het populairst voor kinderfeestjes in Groningen. Springkussens doen het ook heel goed in de zomermaanden. Je kunt activiteiten gewoon combineren in één bestelling.</div>\n      </div>\n\n      <div class=\"kr-faq-item\">\n        <button class=\"kr-faq-q\">Hoe ver van tevoren moet ik reserveren in Groningen?<span class=\"kr-faq-icon\">+</span></button>\n        <div class=\"kr-faq-a\">We adviseren minimaal 3-5 dagen van tevoren te reserveren. In drukke periodes zoals zomervakantie eerder. Check de beschikbaarheid via de webshop.</div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ── TERUG NAAR HOOFDPAGINA ── -->\n<div class=\"kr-back\">\n  <a href=\"/kinderfeestje/\" class=\"kr-back-link\">← Terug naar alle kinderfeestje activiteiten</a>\n</div>\n\n</div><!-- /.kf-regio -->\n\n<script>\n(function() {\n  var srEls = document.querySelectorAll('.kf-regio .sr');\n  var io = new IntersectionObserver(function(entries) {\n    entries.forEach(function(entry) {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('in');\n        io.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.1 });\n  srEls.forEach(function(el) { io.observe(el); });\n\n  document.querySelectorAll('.kf-regio .kr-faq-q').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      var item = this.closest('.kr-faq-item');\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.kf-regio .kr-faq-item').forEach(function(i) { i.classList.remove('open'); });\n      if (!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
